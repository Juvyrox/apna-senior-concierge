---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
---
<Layout title={`Thank you — ${site.name}`} description="Your request has been received." noindex={true}>
  <main id="main" style="min-height:calc(100svh - 88px);display:flex;align-items:center;justify-content:center;padding:calc(2*var(--leading)) var(--edge)">
    <div style="max-width:36rem;text-align:center">
      <span style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green)">Sent</span>
      <h1 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(34px,5vw,52px);line-height:1.1;margin:12px 0 0">Thank you.</h1>
      <p style="font-size:18px;line-height:29px;margin:18px auto 0;max-width:46ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We’ve received your request and will reach out when we're free, in whichever language you preferred. For anything urgent, call or text <a href={site.phoneHref}>{site.phone}</a> and we'll get back to you as soon as we can.</p>
      <p style="font-size:17px;line-height:28px;margin:14px auto 0;max-width:44ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">The first visit is free. Nothing's charged unless you decide to continue.</p>
      <div style="margin-top:calc(1.4*var(--leading))"><a class="btn btn-primary" href="/" style="font-size:16px;padding:12px 22px">Back to home</a></div>
    </div>
  </main>
</Layout>
