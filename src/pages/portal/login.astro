---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PortalHeader from '../../components/PortalHeader.astro';
import { site } from '../../lib/site';
import { supabaseServer } from '../../lib/supabase';

let sent = false;
let errorMsg = '';

try {
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    const email = String(form.get('email') || '').trim();
    if (email) {
      const supabase = supabaseServer(Astro.cookies, Astro.locals.runtime.env);
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: `${site.url}/portal/auth/callback` },
      });
      if (error) errorMsg = "Couldn't send the link just now. Give it a minute and try again.";
      else sent = true;
    } else {
      errorMsg = 'Enter the email you used with Apna.';
    }
  }
} catch {
  errorMsg = "Something went wrong on our end. Try again, or reach us directly.";
}
---
<Layout title={`Client portal — ${site.name}`} noindex={true}>
  <PortalHeader showSignOut={false} />
  <main style="max-width:420px;margin:80px auto;padding:0 20px">
    <h1 style="font-family:var(--font-heading);font-weight:400;font-size:28px;margin:0 0 8px">Client portal</h1>
    {sent ? (
      <p style="font-size:17px;line-height:26px">Check your email. We sent a sign-in link to that address. It expires shortly, so use it soon.</p>
    ) : (
      <form method="POST" style="display:flex;flex-direction:column;gap:14px;margin-top:20px">
        <div class="field">
          <label for="email">Email</label>
          <input class="input" id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </div>
        {errorMsg && <p style="color:var(--color-accent-700);font-size:15px;margin:0">{errorMsg}</p>}
        <button type="submit" class="btn btn-primary">Send sign-in link</button>
        <p style="font-size:14px;line-height:20px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">No password. We email you a one-time link. Use the same email Apna has on file for you. Reach us directly at <a href={`mailto:${site.email}`}>{site.email}</a> if anything's urgent.</p>
      </form>
    )}
  </main>
</Layout>
