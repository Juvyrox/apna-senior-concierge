---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import PortalHeader from '../../../components/PortalHeader.astro';
import { site } from '../../../lib/site';
import { supabaseAdmin } from '../../../lib/supabase';

const admin = supabaseAdmin(Astro.locals.runtime.env);
const today = new Date().toISOString().slice(0, 10);
const thisMonth = today.slice(0, 7);

const [todayVisits, unpaidInvoices, allInvoices, recentInquiries, clientCount] = await Promise.all([
  admin.from('visits').select('*, clients(name)').eq('visit_date', today),
  admin.from('invoices').select('*, clients(name)').neq('status', 'paid').order('billing_period', { ascending: false }),
  admin.from('invoices').select('amount, status, billing_period').eq('status', 'paid'),
  admin.from('booking_requests').select('*').eq('status', 'new').order('created_at', { ascending: false }).limit(5),
  admin.from('clients').select('id', { count: 'exact', head: true }).eq('status', 'active'),
]);

const money = (n: number) => `$${Number(n).toFixed(2)}`;
const revenueThisMonth = (allInvoices.data || [])
  .filter((i) => i.billing_period === thisMonth)
  .reduce((sum, i) => sum + Number(i.amount), 0);
const revenueAllTime = (allInvoices.data || []).reduce((sum, i) => sum + Number(i.amount), 0);
const outstandingTotal = (unpaidInvoices.data || []).reduce((sum, i) => sum + Number(i.amount), 0);
---
<Layout title={`Admin — ${site.name}`} noindex={true}>
  <PortalHeader admin backHref="/portal" backLabel="Your account" />
  <main style="max-width:760px;margin:60px auto 100px;padding:0 20px">
    <h1 style="font-family:var(--font-heading);font-weight:400;font-size:26px;margin:0 0 8px">Admin dashboard</h1>
    <div style="display:flex;gap:20px;margin:16px 0 40px">
      <a href="/portal/admin/clients" style="font-size:14.5px">Clients &rarr;</a>
      <a href="/portal/admin/inquiries" style="font-size:14.5px">Inquiries &rarr;</a>
      <a href="/portal/admin/service-areas" style="font-size:14.5px">Service areas &rarr;</a>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:20px;margin-bottom:40px">
      <div>
        <p style="font-family:var(--font-heading);font-size:26px;margin:0">{clientCount.count || 0}</p>
        <p style="font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:var(--green);margin:4px 0 0">Active clients</p>
      </div>
      <div>
        <p style="font-family:var(--font-heading);font-size:26px;margin:0">{money(revenueThisMonth)}</p>
        <p style="font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:var(--green);margin:4px 0 0">Revenue this month</p>
      </div>
      <div>
        <p style="font-family:var(--font-heading);font-size:26px;margin:0">{money(revenueAllTime)}</p>
        <p style="font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:var(--green);margin:4px 0 0">Revenue all-time</p>
      </div>
      <div>
        <p style="font-family:var(--font-heading);font-size:26px;margin:0;color:var(--color-accent-700)">{money(outstandingTotal)}</p>
        <p style="font-size:13px;letter-spacing:0.05em;text-transform:uppercase;color:var(--green);margin:4px 0 0">Outstanding</p>
      </div>
    </div>

    <section style="margin-bottom:36px">
      <p style="font-size:14.5px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 10px">Today's visits</p>
      {(!todayVisits.data || todayVisits.data.length === 0) && <p style="font-size:15px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Nothing logged for today.</p>}
      {(todayVisits.data || []).map((v: any) => (
        <div style="padding:10px 0;border-top:1px solid var(--color-divider);font-size:15.5px">{v.clients?.name} — {v.hours} hrs {v.companion && `with ${v.companion}`}</div>
      ))}
    </section>

    <section style="margin-bottom:36px">
      <p style="font-size:14.5px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 10px">Outstanding invoices</p>
      {(!unpaidInvoices.data || unpaidInvoices.data.length === 0) && <p style="font-size:15px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Nothing outstanding.</p>}
      {(unpaidInvoices.data || []).map((inv: any) => (
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-top:1px solid var(--color-divider);font-size:15.5px">
          <span>{inv.clients?.name} — {inv.billing_period}</span>
          <span>{money(inv.amount)}</span>
        </div>
      ))}
    </section>

    <section>
      <div style="display:flex;justify-content:space-between;align-items:baseline">
        <p style="font-size:14.5px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 10px">New inquiries</p>
        <a href="/portal/admin/inquiries" style="font-size:14px">See all &rarr;</a>
      </div>
      {(!recentInquiries.data || recentInquiries.data.length === 0) && <p style="font-size:15px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Nothing new.</p>}
      {(recentInquiries.data || []).map((inq: any) => (
        <div style="padding:10px 0;border-top:1px solid var(--color-divider);font-size:15.5px">{inq.name} — {inq.phone}</div>
      ))}
    </section>
  </main>
</Layout>
