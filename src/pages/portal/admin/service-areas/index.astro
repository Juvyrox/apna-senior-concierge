---
export const prerender = false;
import Layout from '../../../../layouts/Layout.astro';
import PortalHeader from '../../../../components/PortalHeader.astro';
import { site } from '../../../../lib/site';
import { supabaseAdmin } from '../../../../lib/supabase';

const admin = supabaseAdmin(Astro.locals.runtime.env);
let msg = '';

const form = Astro.request.method === 'POST' ? await Astro.request.formData() : null;
const action = form?.get('_action');

if (action === 'add') {
  const city = String(form!.get('city') || '').trim();
  const region = String(form!.get('region') || 'San Gabriel Valley').trim();
  const zip_codes = String(form!.get('zip_codes') || '').trim() || null;
  const notes = String(form!.get('notes') || '').trim() || null;
  if (city) {
    const { error } = await admin.from('service_areas').insert({ city, region, zip_codes, notes });
    msg = error ? 'Could not add. Try again.' : `${city} added.`;
  }
} else if (action === 'toggle') {
  const id = String(form!.get('id'));
  const active = form!.get('active') === 'true';
  await admin.from('service_areas').update({ active: !active }).eq('id', id);
} else if (action === 'delete') {
  const id = String(form!.get('id'));
  await admin.from('service_areas').delete().eq('id', id);
}

const { data: areas } = await admin.from('service_areas').select('*').order('region').order('city');
---
<Layout title={`Service areas — ${site.name}`} noindex={true}>
  <PortalHeader admin backHref="/portal/admin" backLabel="Admin dashboard" />
  <main style="max-width:560px;margin:60px auto 100px;padding:0 20px">
    <h1 style="font-family:var(--font-heading);font-weight:400;font-size:26px;margin:0 0 8px">Service areas</h1>
    <p style="font-size:15.5px;color:color-mix(in srgb,var(--color-text) 88%,transparent);margin:0 0 28px">This is your working list, used to flag whether an inquiry falls in the usual area. It doesn't change what's shown on the public site; edit <code>src/data/locations.ts</code> for that.</p>

    {msg && <p style="font-size:15px;margin:0 0 16px">{msg}</p>}

    <form method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:36px;align-items:end">
      <input type="hidden" name="_action" value="add" />
      <div class="field"><label for="city">City</label><input class="input" id="city" name="city" required /></div>
      <div class="field"><label for="region">Region</label><input class="input" id="region" name="region" value="San Gabriel Valley" /></div>
      <div class="field"><label for="zip_codes">Zip codes</label><input class="input" id="zip_codes" name="zip_codes" placeholder="91016, 91024" /></div>
      <button type="submit" class="btn btn-primary">Add</button>
    </form>

    {(areas || []).map((a: any) => (
      <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid var(--color-divider)">
        <div>
          <p style="margin:0;font-size:16px">{a.city} <span style="font-size:13px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">· {a.region}</span>{!a.active && <span style="font-size:12px;color:var(--color-accent-700);margin-left:6px">(inactive)</span>}</p>
          {a.zip_codes && <p style="margin:0;font-size:13.5px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{a.zip_codes}</p>}
        </div>
        <div style="display:flex;gap:6px">
          <form method="POST" style="margin:0"><input type="hidden" name="_action" value="toggle" /><input type="hidden" name="id" value={a.id} /><input type="hidden" name="active" value={a.active} /><button type="submit" class="btn btn-ghost" style="font-size:12px;padding:4px 9px">{a.active ? 'Deactivate' : 'Activate'}</button></form>
          <form method="POST" style="margin:0"><input type="hidden" name="_action" value="delete" /><input type="hidden" name="id" value={a.id} /><button type="submit" class="btn btn-ghost" style="font-size:12px;padding:4px 9px">Remove</button></form>
        </div>
      </div>
    ))}
  </main>
</Layout>
