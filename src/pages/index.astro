---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { hero } from '../data/hero';
import { services } from '../data/services';
import { plans, rateNote } from '../data/plans';
import { faq } from '../data/faq';
import { availability } from '../data/availability';
import { testimonials } from '../data/testimonials';
import { team } from '../data/team';
import { locations } from '../data/locations';
---
<Layout>
  <nav class="nav" aria-label="Primary" style="position:sticky;top:0;z-index:30;background:var(--color-bg);flex-wrap:wrap;row-gap:8px;border-bottom:1px solid var(--color-divider);padding-inline:max(var(--edge),calc((100% - 1180px)/2 + var(--edge)))">
    <a class="nav-brand" href="/" aria-label="Apna Senior Concierge — home" style="display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit">
      <svg viewBox="0 0 44 44" width="28" height="28" aria-hidden="true" style="flex:none;overflow:visible"><g fill="none" stroke="var(--green)" stroke-width="1.25"><rect x="7" y="7" width="30" height="30"></rect><rect x="7" y="7" width="30" height="30" transform="rotate(45 22 22)"></rect><circle cx="22" cy="22" r="7.5" stroke="var(--color-accent)"></circle></g></svg>
      <span style="display:flex;align-items:baseline;gap:9px">Apna<span style="font-size:14px;letter-spacing:0.1em;text-transform:uppercase;color:var(--green)">Senior Concierge</span></span>
    </a>
    <a href="#help" style="white-space:nowrap;font-size:15.5px;text-decoration:none">What we do</a>
    <a href="#plans" style="white-space:nowrap;font-size:15.5px;text-decoration:none">Plans</a>
    <a href="#about" style="white-space:nowrap;font-size:15.5px;text-decoration:none">About</a>
    <a href="#area" style="white-space:nowrap;font-size:15.5px;text-decoration:none">Area</a>
    <a href="#questions" style="white-space:nowrap;font-size:15.5px;text-decoration:none">FAQ</a>
    <a href="/portal/login" style="white-space:nowrap;font-size:15.5px;text-decoration:none;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Client portal</a>
    <a class="btn btn-primary" href="#book" style="white-space:nowrap">Book a call</a>
  </nav>

  <main id="main">
    <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
      <section style="min-height:calc(100svh - 88px);display:flex;flex-direction:column;justify-content:center;padding:calc(2*var(--leading)) 0">
        <h1 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(42px,5.6vw,78px);line-height:1.08;letter-spacing:-0.012em;margin:calc(1.25*var(--leading)) 0 0 -0.042em;max-width:22ch">
          {hero.headlineLines.map((line) => (
            <span style={`display:block${line.italic ? ';font-style:italic;color:var(--green)' : ''}`}>{line.text}</span>
          ))}
        </h1>
        <p style="font-family:var(--font-heading);font-weight:400;font-size:clamp(21px,2.2vw,27px);line-height:1.5;margin:calc(0.9*var(--leading)) 0 0;max-width:52ch;color:color-mix(in srgb,var(--color-text) 92%,transparent)">{hero.subhead}</p>
        <div style="margin-top:calc(1.3*var(--leading));display:flex;gap:14px;flex-wrap:wrap">
          <a class="btn btn-primary" href={hero.ctaPrimary.href} style="font-size:16px;padding:12px 22px">{hero.ctaPrimary.label}</a>
          <a class="btn btn-ghost" href={hero.ctaSecondary.href} style="font-size:16px">{hero.ctaSecondary.label}</a>
        </div>
      </section>

      <section aria-label="In short" style="padding:0 0 calc(2*var(--leading))">
        <div aria-hidden="true" style="display:flex;align-items:center;gap:14px;margin-top:calc(1.1*var(--leading))">
          <span style="height:1px;flex:1;background:var(--color-divider)"></span>
          <span style="width:26px;height:26px;background-image:var(--tile);background-size:26px 26px;opacity:0.7"></span>
          <span style="height:1px;flex:1;background:var(--color-divider)"></span>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:var(--leading) clamp(32px,6vw,88px);margin-top:calc(1.5*var(--leading));align-items:end">
          <p style="font-size:18.5px;line-height:var(--leading);margin:0;max-width:50ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Apna is a concierge service for older adults in the San Gabriel Valley. We drive them to appointments and stay for the appointment. We do the market run. We sit down for chai. It's not medical care. It's the help a child would give if they lived closer.</p>
          <p style="font-size:17px;line-height:28px;margin:var(--leading) 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent);border-left:2px solid var(--green);padding-left:14px">Urdu, Hindi, English, and Memoni are covered today. Ask about another language — we're adding more as families need them, and we'll say plainly if we can't match yours yet.</p>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="At a glance" style="padding:calc(2*var(--leading)) 0">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:calc(1.5*var(--leading)) var(--leading)">
          {availability.stats.map((stat) => (
            <div>
              <p style={`font-family:var(--font-heading);font-weight:400;font-size:clamp(26px,2.4vw,32px);line-height:1.3;margin:0;${stat.accent ? 'color:var(--green);' : ''}${stat.tabularNums ? "font-feature-settings:'tnum' 1;" : ''}`} set:html={stat.value.replace('\n', '<br />')} />
              <p style="font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:color-mix(in srgb,var(--color-text) 88%,transparent);margin:14px 0 0">{stat.label}</p>
            </div>
          ))}
        </div>
      </section>
    </div>

    <div class="ornament-strip" aria-hidden="true"></div>

    <section aria-label="Reflection" style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg));position:relative;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:var(--tile);background-size:88px 88px;opacity:0.16;pointer-events:none"></div>
      <div style="max-width:1180px;margin:0 auto;padding:calc(2.5*var(--leading)) var(--edge);position:relative;text-align:center">
        <p lang="ar" dir="rtl" style="font-family:'Noto Naskh Arabic',serif;font-size:clamp(22px,2.6vw,32px);line-height:2.1;margin:0;color:var(--green-deep);max-width:24ch;margin-inline:auto">وَٱخْفِضْ لَهُمَا جَنَاحَ ٱلذُّلِّ مِنَ ٱلرَّحْمَةِ وَقُل رَّبِّ ٱرْحَمْهُمَا كَمَا رَبَّيَانِى صَغِيرًا</p>
        <p style="font-family:var(--font-heading);font-size:clamp(19px,2vw,25px);line-height:1.5;margin:var(--leading) auto 0;max-width:36ch;color:var(--color-text)">“And lower to them the wing of humility out of mercy, and say: my Lord, have mercy upon them as they raised me when I was small.”</p>
        <p style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;margin:18px 0 0;color:var(--green);font-feature-settings:'tnum' 1">Qur'an 17:24</p>
      </div>
    </section>

    <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
      <section id="help" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">What we do</p>
        <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0 0 var(--leading);max-width:22ch">A week that runs, without anyone having to ask.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:0 calc(2*var(--leading))">
          {services.map((s) => (
            <div style="border-top:1px solid var(--color-divider);padding:16px 0">
              <h3 style="font-family:var(--font-heading);font-weight:400;font-size:20px;margin:0 0 6px">{s.title}</h3>
              <p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="How it starts" style="padding:calc(2.5*var(--leading)) 0">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 var(--leading)">How it starts</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:calc(1.5*var(--leading)) calc(2*var(--leading))">
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">One</span>
            <h3 class="card-title" style="font-weight:400">A free call</h3>
            <p class="card-body" style="line-height:24px;margin:0">Twenty minutes, in whichever language you prefer. We ask about the week — what's already covered, what keeps slipping, and who's been driving until now.</p>
          </div>
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">Two</span>
            <h3 class="card-title" style="font-weight:400">We meet your parent</h3>
            <p class="card-body" style="line-height:24px;margin:0">Chai before anything is booked — thirty minutes, no clipboard. If it isn't a fit, we say so, no questions asked.</p>
          </div>
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">Three</span>
            <h3 class="card-title" style="font-weight:400">A plan built around your week</h3>
            <p class="card-body" style="line-height:24px;margin:0">You pick a plan and we set the same days and hours, every week, under a written agreement before it starts.</p>
          </div>
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">Four</span>
            <h3 class="card-title" style="font-weight:400">Visits you can count on</h3>
            <p class="card-body" style="line-height:24px;margin:0">Same time, every week. And you'll actually know how it went — see below.</p>
          </div>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="How you'll know" style="padding:calc(2.5*var(--leading)) 0">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">How you'll know</p>
        <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0 0 var(--leading);max-width:22ch">"How do I know my mom is okay?"</h2>
        <p style="font-size:17.5px;line-height:29px;margin:0 0 var(--leading);max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">That's the question every daughter asks first. After every visit, you hear from us — not a form, an actual update:</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px 40px;max-width:820px">
          <span style="font-size:17px;line-height:27px">✓ What actually happened, in a real note</span>
          <span style="font-size:17px;line-height:27px">✓ How your parent seemed that day</span>
          <span style="font-size:17px;line-height:27px">✓ A photo, if you'd like one — just ask</span>
          <span style="font-size:17px;line-height:27px">✓ When we'll be back next</span>
          <span style="font-size:17px;line-height:27px">✓ Anything worth flagging, before you hear it from your mother</span>
        </div>
      </section>

      <hr class="hr" />

      <section id="plans" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <div style="display:flex;flex-wrap:wrap;gap:14px calc(2*var(--leading));align-items:baseline;justify-content:space-between">
          <div>
            <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Three plans</p>
            <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:20ch">Pick by how much of the week you want covered.</h2>
          </div>
          <p style="font-size:17px;line-height:28px;margin:0;max-width:34ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">These three plans are where most families start — a guide, not a hard limit. If your week needs more, tell us; on weekends we can go as long as a full day. Every visit is at least two hours, so there's enough time to actually help once we're there. Rates start at $50 an hour and can go up depending on what's needed. Driving included on Dawat and Ghar. Nothing is charged before the first visit.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:calc(1.5*var(--leading)) calc(1.5*var(--leading));margin-top:calc(1.5*var(--leading))">
          {plans.map((plan) => (
            <div class={`card${plan.highlighted ? ' elev-sm' : ''}`} style={`padding:calc(1.25*var(--leading));gap:0${plan.highlighted ? ';border-color:var(--green)' : ''}`}>
              {plan.badge ? (
                <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
                  <h3 style="font-family:var(--font-heading);font-weight:400;font-size:28px;line-height:1.2;margin:0">{plan.name}</h3>
                  <span style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);border:1px solid var(--green);border-radius:var(--radius-sm);padding:3px 8px">{plan.badge}</span>
                </div>
              ) : (
                <h3 style="font-family:var(--font-heading);font-weight:400;font-size:28px;line-height:1.2;margin:0">{plan.name}</h3>
              )}
              <span style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin-top:6px">{plan.hoursLabel.toUpperCase()}</span>
              <p style="font-family:var(--font-heading);font-size:22px;line-height:1.2;margin:10px 0 0">{rateNote.main}<span style="font-family:var(--font-body);font-size:15px;color:color-mix(in srgb,var(--color-text) 70%,transparent)">{rateNote.suffix}</span></p>
              <p style="font-size:17.5px;line-height:29px;margin:16px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{plan.description}</p>
              <div style="display:flex;flex-direction:column;gap:12px;margin-top:20px;border-top:1px solid var(--color-divider);padding-top:16px">
                {plan.features.map((f) => (
                  <span style={`font-size:17px;line-height:27px${f.muted ? ';color:color-mix(in srgb,var(--color-text) 88%,transparent)' : ''}`}>{f.text}</span>
                ))}
              </div>
              <a class={`btn ${plan.highlighted ? 'btn-primary' : 'btn-ghost'}`} href="#book" style={`margin-top:20px;align-self:flex-start${plan.highlighted ? ';border:none' : ''}`}>{plan.ctaLabel}</a>
            </div>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="The driving, and what we can't do" style="padding:calc(2.5*var(--leading)) 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,88px);align-items:start">
        <div>
          <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">What a companion does</p>
          <ul style="list-style:none;padding:0;margin:0 0 calc(2*var(--leading));display:flex;flex-direction:column;gap:10px">
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Driving to appointments, and sitting through them <span style="color:var(--green)">(Dawat and Ghar)</span></span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Groceries, the halal market, the pharmacy counter <span style="color:var(--green)">(on foot in Chai)</span></span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Reading and explaining mail, forms and letters</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Cooking alongside you, and eating at the same table</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Medication reminders — prompting only, never doses</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>A written note to the family after every clinic visit <span style="color:var(--green)">(Dawat and Ghar)</span></span></li>
          </ul>
          <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">The driving</p>
          <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(26px,3vw,36px);line-height:1.25;margin:0;max-width:18ch">The ride isn't the service. Staying is.</h2>
          <p style="font-size:17px;line-height:var(--leading);margin:16px 0 0;max-width:48ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">A rideshare leaves your father at a clinic door with a form he can half read. We park, walk in, sit down, take notes, and drive home by way of the market. It's one visit, billed by the hour, not a fare.</p>
          <p style="font-size:17px;line-height:var(--leading);margin:16px 0 0;max-width:48ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Driving is in our own vehicle. If your parent would rather use their own car, that works too, with the owner's written permission.</p>
        </div>
        <div style="background:color-mix(in srgb, var(--green) 7%, var(--color-bg));border-radius:var(--radius-md);padding:calc(1.4*var(--leading))">
          <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 20px">What we can't do</p>
          <div style="display:flex;flex-direction:column;gap:20px">
            <p style="margin:0;font-size:17px;line-height:28px;color:color-mix(in srgb,var(--color-text) 88%,transparent)"><span style="display:block;color:var(--color-text);font-family:var(--font-heading);font-size:19px;line-height:1.4;margin-bottom:3px">No lifting, carrying or transferring.</span> We can walk beside someone and steady a door, but not move a person in or out of a chair, bed or car.</p>
            <p style="margin:0;font-size:17px;line-height:28px;color:color-mix(in srgb,var(--color-text) 88%,transparent)"><span style="display:block;color:var(--color-text);font-family:var(--font-heading);font-size:19px;line-height:1.4;margin-bottom:3px">No hands-on personal care.</span> Bathing, dressing and toileting need a licensed home care organization. We are not one.</p>
            <p style="margin:0;font-size:17px;line-height:28px;color:color-mix(in srgb,var(--color-text) 88%,transparent)"><span style="display:block;color:var(--color-text);font-family:var(--font-heading);font-size:19px;line-height:1.4;margin-bottom:3px">No medication or nursing tasks.</span> We remind. We don't measure, fill or give a dose, and no injections or wound care.</p>
            <p style="margin:0;font-size:17px;line-height:28px;color:color-mix(in srgb,var(--color-text) 88%,transparent)"><span style="display:block;color:var(--color-text);font-family:var(--font-heading);font-size:19px;line-height:1.4;margin-bottom:3px">No medical transport.</span> No gurney or wheelchair lift, and nobody who needs monitoring on the way.</p>
          </div>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="Why families pick us" style="padding:calc(2.5*var(--leading)) 0">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Why families pick us</p>
        <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0 0 var(--leading);max-width:24ch">Things we don't have to be told.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0 calc(2*var(--leading))">
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">The language</h3><p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Urdu at the kitchen table. Nothing gets translated through a grandchild who's at work.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Salah</h3><p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">The day is planned around prayer times. If we're out, we find somewhere clean to pray and we wait.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Woman-owned, woman-led</h3><p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Every visit is with a woman — for a mother or grandmother who's more comfortable that way, one less thing to explain or negotiate.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Ramadan and Eid</h3><p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Hours move for suhoor and taraweeh. Eid morning is arranged weeks ahead, not squeezed in.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Adab of the house</h3><p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Shoes off at the door. Elders addressed properly. The kitchen kept the way it's kept.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Asking is the hard part</h3><p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Our elders weren't raised to ask for help. So we don't make anyone say it twice, and we don't make a thing of it.</p></div>
        </div>
      </section>
    </div>

    <div class="ornament-strip" aria-hidden="true"></div>

    <section id="about" style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg));scroll-margin-top:76px">
      <div style="max-width:1180px;margin:0 auto;padding:calc(2.5*var(--leading)) var(--edge)">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">About</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,88px);align-items:start">
          <div>
            <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:18ch">{team[0].headline}</h2>
            {team[0].bioParagraphs.map((p, i) => (
              <p style={`font-size:17.5px;line-height:var(--leading);margin:${i === 0 ? '20px' : '18px'} 0 0;max-width:52ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)`}>{p}</p>
            ))}
            <p style="font-family:var(--font-heading);font-size:21px;line-height:1.4;margin:22px 0 0">{team[0].name}<span style="display:block;font-family:var(--font-body);font-size:15.5px;color:color-mix(in srgb,var(--color-text) 88%,transparent);margin-top:4px">{team[0].role}</span></p>
          </div>
          <div style="display:flex;flex-direction:column;gap:var(--leading);align-self:end">
            <div>
              <p style="display:block;font-size:13px;line-height:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 10px">How to check us out</p>
              <p style="font-size:15px;line-height:23px;margin:0;max-width:40ch;color:color-mix(in srgb,var(--color-text) 78%,transparent)">Meet us before you commit to anything, and read the paperwork first. The first visit is free — thirty minutes, nothing to sign. A written service agreement is required, setting out rates, scope and terms; visits are cancelled or moved with 24 hours' notice, always. If something matters to you that isn't listed above, ask us and we are happy to provide an answer.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="ornament-strip" aria-hidden="true"></div>

    {testimonials.length > 0 && (
      <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
        <section aria-label="What families say" style="padding:calc(2.5*var(--leading)) 0">
          <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">What families say</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:calc(1.5*var(--leading)) calc(2*var(--leading))">
            {testimonials.map((t) => (
              <div style="border-top:1px solid var(--color-divider);padding:18px 0">
                <p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">"{t.quote}"</p>
                <p style="font-family:var(--font-heading);font-size:16px;margin:14px 0 0">{t.name}{t.relation && <span style="display:block;font-family:var(--font-body);font-size:14.5px;color:color-mix(in srgb,var(--color-text) 88%,transparent);margin-top:2px">{t.relation}</span>}</p>
              </div>
            ))}
          </div>
        </section>
        <hr class="hr" />
      </div>
    )}

    <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
      <section id="area" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Where we go</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:calc(1.5*var(--leading)) calc(2*var(--leading))">
          {locations.map((loc) => (
            <div style="border-top:1px solid var(--color-divider);padding-top:18px">
              <h2 style="font-family:var(--font-heading);font-weight:400;font-size:26px;line-height:1.25;margin:0">{loc.name}</h2>
              <p style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:8px 0 0">{loc.cadence}</p>
              <p style="font-size:17.5px;line-height:29px;margin:14px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{loc.description}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section id="questions" aria-label="Frequently asked questions" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 var(--leading)">Frequently asked questions</p>
        <div style="max-width:78ch">
          {faq.map((item, i) => (
            <details style={`border-top:1px solid var(--color-divider)${i === faq.length - 1 ? ';border-bottom:1px solid var(--color-divider)' : ''}`}>
              <summary style="cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0;font-family:var(--font-heading);font-size:19px;line-height:1.35">{item.question}<span class="chev" aria-hidden="true" style="flex:none;width:9px;height:9px;border-right:1px solid var(--green);border-bottom:1px solid var(--green);transform:rotate(45deg);transition:transform .2s"></span></summary>
              <p style="font-size:17.5px;line-height:29px;margin:0 0 18px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section id="book" style="padding:calc(2.5*var(--leading)) 0 calc(2*var(--leading));scroll-margin-top:76px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,80px);align-items:start">
        <div>
          <p style="display:block;font-size:14.5px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Book a free call</p>
          <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:18ch">Tell us about the week you're trying to cover.</h2>
          <p style="font-size:17px;line-height:var(--leading);margin:18px 0 0;max-width:44ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Three short steps, about two minutes. We'll call you back when we're free, in whichever language you prefer. Nothing is booked and nothing is charged from this form.</p>
          <p style="font-size:17px;line-height:var(--leading);margin:var(--leading) 0 0"><a href={`mailto:${site.email}`}>{site.email}</a><br /><span style="color:color-mix(in srgb,var(--color-text) 88%,transparent)">Juveriyah Salat, founder</span></p>
          <p style="font-size:15px;line-height:23px;margin:var(--leading) 0 0;max-width:40ch;color:color-mix(in srgb,var(--color-text) 88%,transparent);border-left:2px solid var(--green);padding-left:14px">Don't put medical details in this form. Save those for the call.</p>
        </div>

        <div style="border:1px solid var(--color-divider);border-radius:var(--radius-md);padding:calc(1.25*var(--leading))">
          <!-- Progress bar -->
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:var(--leading)">
            <span data-bar="1" style="height:2px;flex:1;background:var(--green)"></span>
            <span data-bar="2" style="height:2px;flex:1;background:var(--color-divider)"></span>
            <span data-bar="3" style="height:2px;flex:1;background:var(--color-divider)"></span>
            <span data-steplabel style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);white-space:nowrap;font-feature-settings:'tnum' 1">Step 1 of 3</span>
          </div>

          <noscript>
            <p style="font-size:16px;line-height:26px;margin:0 0 var(--leading);padding:12px 14px;border:1px solid var(--color-divider);border-radius:var(--radius-md)">To book a free call, email <a href={`mailto:${site.email}`}>{site.email}</a>, call <a href={site.phoneHref}>{site.phone}</a>, or message on <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>. Tell us who it's for, your city, and the best time and language to reach you.</p>
          </noscript>
          <form name="booking" method="POST" id="booking-form" novalidate data-endpoint={site.formEndpoint} data-email={site.email}>
            <p hidden aria-hidden="true"><label>Leave this field blank<input name="company" tabindex="-1" autocomplete="off" /></label></p>

            <!-- STEP 1 -->
            <div class="form-step" data-step="1">
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:22px;line-height:1.3;margin:0">Who is this for?</p>
                <div class="field">
                  <label for="a-rel">This is for</label>
                  <select class="input" id="a-rel" name="relationship">
                    <option>My mother</option><option>My father</option><option>Both parents</option>
                    <option>Another relative</option><option>Myself</option><option>A client or congregant of mine</option>
                  </select>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-4)">
                  <div class="field">
                    <label for="a-age">Their age</label>
                    <input class="input" id="a-age" name="age" type="text" inputmode="numeric" placeholder="78" />
                  </div>
                  <div class="field">
                    <label for="a-city">City</label>
                    <select class="input" id="a-city" name="city">
                      <option>Monrovia</option><option>Arcadia</option><option>Pasadena</option><option>Duarte</option>
                      <option>Temple City</option><option>Rosemead or San Gabriel</option><option>Alhambra</option>
                      <option>Covina or West Covina</option><option>Elsewhere in the SGV</option><option>Orange County</option>
                      <option>Somewhere else</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="a-mob">Getting around</label>
                  <select class="input" id="a-mob" name="mobility">
                    <option>Walks on their own</option><option>Walks slowly, prefers an arm</option><option>Uses a cane</option>
                    <option>Uses a walker</option><option>Uses a wheelchair, transfers themselves</option>
                    <option>Uses a wheelchair, needs help transferring</option>
                  </select>
                  <span style="font-size:14px;line-height:20px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We can walk alongside and steady a door. We can't lift, carry or transfer anyone.</span>
                </div>
                <p data-lift-warning hidden style="margin:0;font-size:15px;line-height:22px;color:var(--color-accent-700);border:1px solid var(--color-accent);border-radius:var(--radius-md);padding:12px 14px">Send this in anyway. We'll be straight with you on the call about what we can cover and who to call for the rest.</p>
                <div class="field">
                  <span style="font-size:14.5px;letter-spacing:0.04em">Companion preference</span>
                  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;margin-top:6px">
                    <label class="radio" style="cursor:pointer"><input type="radio" name="companion" value="A woman" checked /><span class="dot"></span>A woman</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="companion" value="No preference" /><span class="dot"></span>No preference</label>
                  </div>
                  <p style="font-size:15.5px;line-height:24px;margin:8px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Every companion today is a woman. If your father would be more comfortable with a man, tell us on the call and we'll be honest about whether we can help yet.</p>
                </div>
                <div><button type="button" class="btn btn-primary" data-next>Next</button></div>
              </div>
            </div>

            <!-- STEP 2 -->
            <div class="form-step" data-step="2" hidden>
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:22px;line-height:1.3;margin:0">What does the week need?</p>
                <div class="field">
                  <span style="font-size:14.5px;letter-spacing:0.04em">Which day works better</span>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px" data-days>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Sat">Saturday</button>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Sun">Sunday</button>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Either">Either</button>
                  </div>
                  <input type="hidden" name="days" id="a-days" value="" />
                </div>
                <div class="field">
                  <label for="a-hours">Hours you have in mind</label>
                  <select class="input" id="a-hours" name="hours">
                    <option>About 2 a week — Chai</option><option>About 4 a week — Dawat</option>
                    <option>About 6 a week — Ghar</option><option>Not sure yet, help me work it out</option>
                  </select>
                </div>
                <div class="field">
                  <label for="a-need">What's going unhandled right now?</label>
                  <textarea class="input" id="a-need" name="need" rows="4" style="resize:vertical;font-family:var(--font-body);line-height:24px" placeholder="Nobody free to drive on Fridays. He hasn't been to Jummah since March, and the pharmacy calls keep piling up."></textarea>
                </div>
                <div class="field">
                  <label for="a-before">Have you used something like this before?</label>
                  <select class="input" id="a-before" name="experience">
                    <option>No, this is the first time</option><option>Yes, an agency</option>
                    <option>Yes, someone from the community</option><option>We tried and it didn't work out</option>
                  </select>
                </div>
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap">
                  <button type="button" class="btn btn-ghost" data-back>Back</button>
                  <button type="button" class="btn btn-primary" data-next>Next</button>
                </div>
              </div>
            </div>

            <!-- STEP 3 -->
            <div class="form-step" data-step="3" hidden>
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:22px;line-height:1.3;margin:0">How do we reach you?</p>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-4)">
                  <div class="field" data-field="name">
                    <label for="a-name">Your name</label>
                    <input class="input" id="a-name" name="name" type="text" autocomplete="name" placeholder="Ayesha" required aria-describedby="err-name" />
                    <span class="field-error" id="err-name">We need a name to ask for.</span>
                  </div>
                  <div class="field" data-field="phone">
                    <label for="a-phone">Phone</label>
                    <input class="input" id="a-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(626) 555 0142" required aria-describedby="err-phone" />
                    <span class="field-error" id="err-phone">A number we can actually call, please.</span>
                  </div>
                </div>
                <div class="field">
                  <label for="a-email">Email, if you'd rather</label>
                  <input class="input" id="a-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="err-email" />
                  <span class="field-error" id="err-email">That email doesn't look right — check it over.</span>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-4)">
                  <div class="field">
                    <label for="a-when">Best time to call</label>
                    <select class="input" id="a-when" name="best_time">
                      <option>Mornings</option><option>Afternoons</option><option>Evenings after 6</option><option>Weekends</option><option>Any time</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="a-heard">How did you hear about us?</label>
                    <select class="input" id="a-heard" name="heard">
                      <option>From the masjid</option><option>From a friend or relative</option><option>A community WhatsApp group</option>
                      <option>Instagram or Facebook</option><option>Search</option><option>Somewhere else</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <span style="font-size:14.5px;letter-spacing:0.04em">Language for the call</span>
                  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;margin-top:6px">
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Urdu" checked /><span class="dot"></span>Urdu</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="English" /><span class="dot"></span>English</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Memoni" /><span class="dot"></span>Memoni</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Either" /><span class="dot"></span>Either</label>
                  </div>
                </div>
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:center">
                  <button type="button" class="btn btn-ghost" data-back>Back</button>
                  <button type="submit" class="btn btn-primary" data-submit>Send it</button>
                </div>
                <span style="font-size:14px;line-height:20px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We don't share anything you write here with anyone outside Apna.</span>
              </div>
            </div>

            <!-- DONE -->
            <div class="form-step" data-step="done" hidden aria-live="polite">
              <div style="display:flex;flex-direction:column;gap:14px">
                <span style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green)">Sent</span>
                <p data-thanks style="font-family:var(--font-heading);font-size:26px;line-height:1.3;margin:0">Thank you.</p>
                <p style="font-size:17.5px;line-height:29px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We'll call <span data-shown-phone>you</span>, <span data-shown-when>at a good time</span>. For anything urgent, call or text <a href={site.phoneHref}>{site.phone}</a> and we'll get back to you as soon as we can.</p>
                <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">The first visit is free — nothing's charged unless you decide to continue.</p>
                <div><button type="button" class="btn btn-ghost" data-restart>Send another</button></div>
              </div>
            </div>
          </form>
        </div>
      </section>
    </div>
  </main>

  <div class="ornament-strip" aria-hidden="true"></div>

  <footer style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg))">
    <div style="max-width:1180px;margin:0 auto;padding:calc(2*var(--leading)) var(--edge);display:flex;flex-wrap:wrap;gap:var(--leading) calc(2*var(--leading));justify-content:space-between;font-size:14.5px;line-height:23px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">
      <div style="max-width:64ch">
        <p style="margin:0 0 10px;color:var(--color-text);font-family:var(--font-heading);font-size:18px">Apna Senior Concierge · San Gabriel Valley, California</p>
        <p style="margin:0 0 12px">Non-medical companion, errand and transportation-assistance services. Apna is not a licensed home care organization, home health agency, hospice or charter-party carrier, and provides no medical, nursing, legal, immigration or financial services or advice. We do not lift, carry or transfer clients, administer medication, or perform any task requiring a license. Driving is provided as part of hourly companion visits and is not sold as a separate fare. Services are open to everyone in the service area regardless of faith, national origin, disability or any other characteristic protected under California law.</p>
        <p style="margin:0"><a href="/privacy/" style="color:var(--color-accent-700)">Privacy Policy</a> &nbsp;·&nbsp; <a href="/terms/" style="color:var(--color-accent-700)">Terms of Service</a></p>
      </div>
      <div style="display:flex;flex-direction:column;gap:7px">
        <a href={`mailto:${site.email}`} style="text-decoration:none">{site.email}</a>
        <a href={site.phoneHref} style="text-decoration:none">{site.phone}</a>
        <a href={site.whatsappHref} style="text-decoration:none" target="_blank" rel="noopener">WhatsApp</a>
        <span>Juveriyah Salat, founder</span>
      </div>
    </div>
  </footer>

  <script>
    // ── Booking form: step navigation, validation, spam-safe Netlify submit ──
    const form = document.getElementById('booking-form');
    if (form) {
      const steps = ['1', '2', '3'];
      let current = 0;

      const stepEls = new Map();
      form.querySelectorAll('.form-step').forEach((el) => {
        stepEls.set(el.getAttribute('data-step'), el);
      });
      const bars = [1, 2, 3].map((n) => document.querySelector(`[data-bar="${n}"]`));
      const stepLabel = document.querySelector('[data-steplabel]');

      function show(key) {
        stepEls.forEach((el, k) => { el.hidden = k !== key; });
        if (key === '1' || key === '2' || key === '3') {
          const idx = Number(key);
          bars.forEach((b, i) => {
            if (b) b.style.background = i < idx ? 'var(--green)' : 'var(--color-divider)';
          });
          if (stepLabel) stepLabel.textContent = `Step ${key} of 3`;
        }
      }

      // Lift warning
      const mob = form.querySelector('#a-mob');
      const lift = form.querySelector('[data-lift-warning]');
      function syncLift() {
        if (lift && mob) lift.hidden = mob.value !== 'Uses a wheelchair, needs help transferring';
      }
      mob && mob.addEventListener('change', syncLift);
      syncLift();

      // Day toggles → hidden input
      const daysInput = form.querySelector('#a-days');
      form.querySelectorAll('.day-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const on = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', on ? 'false' : 'true');
          const picked = Array.from(form.querySelectorAll('.day-toggle[aria-pressed="true"]'))
            .map((b) => b.getAttribute('data-day'));
          if (daysInput) daysInput.value = picked.join(', ');
        });
      });

      // Validation helpers
      function setError(fieldName, on) {
        const wrap = form.querySelector(`[data-field="${fieldName}"]`);
        if (wrap) wrap.classList.toggle('has-error', on);
        return !on;
      }
      function validateStep3() {
        const name = form.querySelector('#a-name');
        const phone = form.querySelector('#a-phone');
        const email = form.querySelector('#a-email');
        let ok = true;
        ok = setError('name', !(name && name.value.trim().length > 0)) && ok;
        const digits = (phone && phone.value.replace(/\D/g, '')) || '';
        ok = setError('phone', digits.length < 10) && ok;
        // email optional, but if present must be plausible
        const emailWrap = email && email.closest('.field');
        if (email && email.value.trim()) {
          const good = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
          emailWrap && emailWrap.classList.toggle('has-error', !good);
          ok = good && ok;
        } else if (emailWrap) {
          emailWrap.classList.remove('has-error');
        }
        return ok;
      }

      form.querySelectorAll('[data-next]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (current < steps.length - 1) { current += 1; show(steps[current]); }
        })
      );
      form.querySelectorAll('[data-back]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (current > 0) { current -= 1; show(steps[current]); }
        })
      );

      const endpoint = form.dataset.endpoint || '';
      const contactEmail = form.dataset.email || '';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot: a bot filled the hidden field — silently accept, send nothing.
        const hp = form.querySelector('[name="company"]');
        if (hp && hp.value) { show('done'); return; }

        if (!validateStep3()) {
          const bad = form.querySelector('.field.has-error .input');
          bad && bad.focus();
          return;
        }
        const submitBtn = form.querySelector('[data-submit]');
        submitBtn && (submitBtn.disabled = true);

        const fields = Object.fromEntries(new FormData(form).entries());
        delete fields.company;

        if (endpoint) {
          // Automatic delivery to a configured endpoint (e.g. a Supabase function).
          try {
            await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(fields),
            });
          } catch (err) {
            // Don't trap the user if the network hiccups — still confirm.
          }
        } else if (contactEmail) {
          // No endpoint configured: open the visitor's mail app, pre-filled.
          const order = [
            ['name', 'Name'], ['phone', 'Phone'], ['email', 'Email'],
            ['relationship', 'This is for'], ['age', 'Age'], ['city', 'City'],
            ['mobility', 'Getting around'], ['companion', 'Companion preference'],
            ['days', 'Days that matter'], ['hours', 'Hours in mind'],
            ['experience', 'Used before'], ['best_time', 'Best time to call'],
            ['language', 'Language for the call'], ['heard', 'Heard about us'],
          ];
          const lines = order
            .filter(([k]) => fields[k])
            .map(([k, label]) => `${label}: ${fields[k]}`);
          if (fields.need) lines.push('', "What's going unhandled:", fields.need);
          const subject = `Apna booking request — ${fields.name || 'new enquiry'}`;
          window.location.href =
            'mailto:' + contactEmail +
            '?subject=' + encodeURIComponent(subject) +
            '&body=' + encodeURIComponent(lines.join('\n'));
        }

        const phoneVal = (form.querySelector('#a-phone').value || '').trim();
        const whenVal = (form.querySelector('#a-when').value || '').toLowerCase();
        const nameVal = (form.querySelector('#a-name').value || '').trim();
        const sp = document.querySelector('[data-shown-phone]');
        const sw = document.querySelector('[data-shown-when]');
        const th = document.querySelector('[data-thanks]');
        if (sp) sp.textContent = phoneVal || 'you';
        if (sw) sw.textContent = whenVal ? `— ${whenVal}` : 'at a good time';
        if (th && nameVal) th.textContent = `Thank you, ${nameVal.split(' ')[0]}.`;
        show('done');
      });

      form.querySelector('[data-restart]')?.addEventListener('click', () => {
        form.reset();
        form.querySelectorAll('.field.has-error').forEach((f) => f.classList.remove('has-error'));
        form.querySelectorAll('.day-toggle[aria-pressed="true"]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        if (daysInput) daysInput.value = '';
        syncLift();
        const submitBtn = form.querySelector('[data-submit]');
        submitBtn && (submitBtn.disabled = false);
        current = 0; show('1');
      });
    }
  </script>
</Layout>
