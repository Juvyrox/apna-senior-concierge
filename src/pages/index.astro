---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { services } from '../data/services';
import { plans } from '../data/plans';
import { faq } from '../data/faq';
import { testimonials } from '../data/testimonials';
import { team } from '../data/team';
---
<Layout>
  <nav class="nav" aria-label="Primary" style="position:sticky;top:0;z-index:30;background:var(--color-bg);flex-wrap:wrap;row-gap:8px;border-bottom:1px solid var(--color-divider);padding-inline:max(var(--edge),calc((100% - 1180px)/2 + var(--edge)))">
    <a class="nav-brand" href="/" aria-label="Apna Senior Concierge home" style="display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit">
      <img src="/apna-logo.svg" alt="Apna Senior Concierge" height="52" style="display:block;height:52px;width:auto" />
    </a>
    <a href="#help" style="white-space:nowrap;font-size:15px;text-decoration:none">What I do</a>
    <a href="#plans" style="white-space:nowrap;font-size:15px;text-decoration:none">Plans</a>
    <a href="#estate" style="white-space:nowrap;font-size:15px;text-decoration:none">Estate Transition</a>
    <a href="#about" style="white-space:nowrap;font-size:15px;text-decoration:none">About</a>
    <a href="#questions" style="white-space:nowrap;font-size:15px;text-decoration:none">FAQ</a>
    <a href="/portal/login" style="white-space:nowrap;font-size:15px;text-decoration:none;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Client portal</a>
    <a class="btn btn-primary" href="#book" style="white-space:nowrap">Book a call</a>
  </nav>

  <main id="main">
    <div class="wrap">
      <section class="hero" aria-label="Introduction">
        {site.launchNote && <p class="pill">{site.launchNote}</p>}
        <h1 class="h1">Your parents shouldn't have to explain themselves <em>in English.</em></h1>
        <p class="lede" style="margin-top:24px">I'm Juveriyah. I visit your parents every weekend and speak with them in Urdu or Hindi. They have company and a hand with the small things, and you hear how they are after every visit.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#book">Book a free call</a>
          <a class="btn btn-secondary" href={site.whatsappHref} target="_blank" rel="noopener">Message on WhatsApp</a>
          <a class="btn btn-ghost" href={site.phoneHref}>or call {site.phone}</a>
        </div>
        <ul class="facts">
          <li>San Gabriel Valley</li>
          <li>Saturdays and Sundays</li>
          <li>Urdu, Hindi and English</li>
          <li>The same person every visit</li>
        </ul>
      </section>
    </div>

    <section id="help" class="band" style="scroll-margin-top:76px">
      <div class="wrap sec split">
        <div>
          <p class="eyebrow">A Saturday visit</p>
          <h2 class="h2">What a visit looks like.</h2>
          <p class="p">Every family is different, so every visit is too. This is a common one.</p>
          <ol class="day">
            <li><time>2:00</time><div><strong>I arrive, shoes off at the door.</strong>Chai first, and how the week has been.</div></li>
            <li><time>2:30</time><div><strong>The mail and the phone.</strong>I read the letters aloud and we sort what needs a reply. Then we fix whatever the phone has done this week.</div></li>
            <li><time>3:15</time><div><strong>Something they enjoy.</strong>Cooking together, a walk down the street, old photographs, or a video call with family abroad.</div></li>
            <li><time>4:00</time><div><strong>You hear from me.</strong>Before I leave, you have a note about the visit.</div></li>
          </ol>
        </div>
        <div>
          <p class="eyebrow">The note you receive</p>
          <div class="note">
            <p class="note-meta">An example, not a real family</p>
            <p>Ammi was in good spirits today. We had chai and went through the week's mail. One letter from the county needs a reply from you, and I have sent you a photo of it.</p>
            <p>We set up the video call with your brother and she spoke with him for twenty minutes. She asked me to help her find her glasses prescription next week.</p>
            <p>I'll be back Saturday at 2.</p>
          </div>
          <ul class="ticks" style="margin-top:28px">
            <li>What we did and how the visit went</li>
            <li>How your parent seemed that day</li>
            <li>A photo, with your parent's permission</li>
            <li>Anything that needs your attention</li>
            <li>When I'll be back</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="wrap">
      <section class="sec" aria-label="What I help with">
        <p class="eyebrow">What I help with</p>
        <h2 class="h2">Help with the week, without anyone having to ask.</h2>
        <div class="grid" style="margin-top:28px">
          {services.map((s) => (
            <div class="card">
              <h3 class="h3">{s.title}</h3>
              <p class="p">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section class="sec" aria-label="How it starts">
        <p class="eyebrow">How it starts</p>
        <h2 class="h2">Nothing to sign until you have met me.</h2>
        <ol class="steps grid" style="margin-top:28px">
          <li><h3 class="h3">A free call</h3><p class="p">Twenty minutes by phone, in the language you prefer. You tell me what help is already in place and where it falls short.</p></li>
          <li><h3 class="h3">I meet your parent</h3><p class="p">A free thirty-minute visit over chai, with you there if you can be. If I am not the right fit, I will say so.</p></li>
          <li><h3 class="h3">A day and time that is yours</h3><p class="p">You choose a plan and we agree on the same day and time each week, written into an agreement before visits begin.</p></li>
          <li><h3 class="h3">Visits you can count on</h3><p class="p">I come at the agreed time each week, and you receive a note after every visit.</p></li>
        </ol>
      </section>
    </div>

    <section id="plans" class="band" style="scroll-margin-top:76px">
      <div class="wrap sec">
        <p class="eyebrow">Three plans</p>
        <h2 class="h2">Choose the amount of time that suits your family.</h2>
        <p class="p">Each plan is a set time every weekend, with me. Visits are at least two hours, at {site.rateHourly}. {site.foundingNote}</p>
        <div class="grid" style="margin-top:32px;align-items:stretch">
          {plans.map((plan) => (
            <div class={`card plan${plan.highlighted ? ' is-featured' : ''}`}>
              <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                <h3 class="h3" style="font-size:30px;margin:0">{plan.name}</h3>
                {plan.badge && <span class="badge">{plan.badge}</span>}
              </div>
              <p class="eyebrow" style="margin:6px 0 0">{plan.hoursLabel}</p>
              <p class="price">{plan.priceMonthly} <span>a month</span></p>
              <p class="p" style="margin-top:12px">{plan.description}</p>
              <div style="margin:20px 0 24px;border-top:1px solid var(--color-divider);padding-top:18px">
                <p class="small" style="margin:0 0 12px;font-weight:600">{plan.featuresHeader}</p>
                <ul class="ticks">
                  {plan.features.map((f) => (<li>{f.text}</li>))}
                </ul>
              </div>
              <a class="btn btn-primary" href="#book">{plan.ctaLabel}</a>
            </div>
          ))}
        </div>
        <p class="small" style="margin:22px 0 0;max-width:64ch">Not sure which one? Most families start small and add time later. I will help you work it out on the call.</p>
      </div>
    </section>

    <div class="wrap">
      <section class="sec split" aria-label="What matters, and what I do not do">
        <div>
          <p class="eyebrow">What matters to our families</p>
          <h2 class="h2">The small things are the point.</h2>
          <ul class="ticks" style="gap:18px">
            <li><strong>The language.</strong> Conversation in your parent's own language, so nothing has to be relayed through a grandchild.</li>
            <li><strong>Salah.</strong> Visits are planned around prayer times.</li>
            <li><strong>Adab of the house.</strong> Shoes off at the door, elders addressed with respect, the kitchen left as I found it.</li>
            <li><strong>Asking is the hard part.</strong> Many elders were not raised to ask for help. I do not make anyone repeat a request, and I do not make it awkward.</li>
          </ul>
        </div>
        <div class="card">
          <p class="eyebrow">So you know</p>
          <h3 class="h3">What I do not do</h3>
          <ul class="nots" style="margin-top:14px">
            <li>Medical or nursing care</li>
            <li>Giving medication. I can remind, and that is all.</li>
            <li>Lifting, bathing or dressing</li>
            <li>Legal, tax or money advice, or handling money</li>
            <li>Driving your parent, for now. I can meet them where they are going.</li>
          </ul>
          <p class="small" style="margin:18px 0 0">If your parent needs one of these, I will tell you on the first call so you can find the right help.</p>
        </div>
      </section>

      <hr class="hr" />

      <section id="estate" class="sec split" aria-label="Estate Transition Concierge" style="scroll-margin-top:76px">
        <div>
          <p class="eyebrow">Estate Transition Concierge</p>
          <h2 class="h2">Help for your family when a parent's home changes hands.</h2>
        </div>
        <div>
          <p class="p">When a parent passes, moves or downsizes, the home still needs attention while the family is already carrying a great deal. I handle the logistics: a task list and timeline, vendors you choose, papers organized into labeled folders, calls in your parent's language, and a written update after every visit.</p>
          <p class="p">{site.estateRate}, depending on the size of the project. The first consultation is free.</p>
          <div class="hero-actions" style="margin-top:24px">
            <a class="btn btn-secondary" href="/estate-transition/#consult">Ask about estate transition</a>
            <a class="btn btn-ghost" href="/estate-transition/">Read the details</a>
          </div>
        </div>
      </section>
    </div>

    <section aria-label="Reflection" class="band" style="position:relative;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:var(--tile);background-size:88px 88px;opacity:0.14;pointer-events:none"></div>
      <div class="wrap sec" style="position:relative;text-align:center">
        <p lang="ar" dir="rtl" style="font-family:'Noto Naskh Arabic',serif;font-size:clamp(28px,3.2vw,40px);line-height:2.1;margin:0;color:var(--green-deep);max-width:24ch;margin-inline:auto">وَٱخْفِضْ لَهُمَا جَنَاحَ ٱلذُّلِّ مِنَ ٱلرَّحْمَةِ وَقُل رَّبِّ ٱرْحَمْهُمَا كَمَا رَبَّيَانِى صَغِيرًا</p>
        <p style="font-family:var(--font-heading);font-size:clamp(21px,2.4vw,28px);line-height:1.5;margin:var(--leading) auto 0;max-width:36ch">“And lower to them the wing of humility out of mercy, and say: my Lord, have mercy upon them as they raised me when I was small.”</p>
        <p class="eyebrow" style="margin:18px 0 0">Qur'an 17:24</p>
      </div>
    </section>

    <div class="wrap">
      <section id="about" class="sec split" style="scroll-margin-top:76px">
        <div>
          <p class="eyebrow">About</p>
          <h2 class="h2">{team[0].headline}</h2>
          {team[0].bioParagraphs.map((p) => (<p class="p">{p}</p>))}
          <p class="p">Apna means "our own." That is how I would like your parents to feel about my visits.</p>
          <p class="sign">{team[0].name}</p>
          <p class="small" style="margin:4px 0 0">{team[0].role}</p>
        </div>
        <div class="card">
          <p class="eyebrow">Meet me first</p>
          <p class="p">There is nothing to sign at the first visit. Your parent decides whether I am welcome, and you decide whether this is right for your family.</p>
          <p class="p">If you continue, a written agreement sets out the rate, what I do and what I do not do. Visits can be moved or cancelled with 24 hours' notice.</p>
          <div class="hero-actions" style="margin-top:22px">
            <a class="btn btn-primary" href="#book">Book a free call</a>
          </div>
        </div>
      </section>

      {testimonials.length > 0 && (
        <section class="sec" aria-label="What families say" style="padding-top:0">
          <p class="eyebrow">What families say</p>
          <div class="grid">
            {testimonials.map((t) => (
              <div class="card">
                <p class="p">"{t.quote}"</p>
                <p class="small" style="margin:14px 0 0"><strong>{t.name}</strong>{t.relation && <span style="display:block">{t.relation}</span>}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <hr class="hr" />

      <section id="questions" class="sec faq" aria-label="Frequently asked questions" style="scroll-margin-top:76px">
        <p class="eyebrow">Questions families ask</p>
        <h2 class="h2">Ask me anything else on the call.</h2>
        <div style="max-width:78ch;margin-top:24px">
          {faq.map((item) => (
            <details>
              <summary>{item.question}<span class="chev" aria-hidden="true" style="flex:none;width:10px;height:10px;border-right:2px solid var(--green);border-bottom:2px solid var(--green);transform:rotate(45deg);transition:transform .2s"></span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section id="book" style="padding:calc(2.5*var(--leading)) 0 calc(2*var(--leading));scroll-margin-top:76px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,80px);align-items:start">
        <div>
          <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Book a free call</p>
          <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:18ch">Tell me about the week you're trying to cover.</h2>
          <p style="font-size:17px;line-height:var(--leading);margin:18px 0 0;max-width:44ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Three short steps, about two minutes. I will call you back in the language you prefer. Nothing is booked or charged from this form.</p>
          <p style="font-size:15px;line-height:23px;margin:var(--leading) 0 0;max-width:40ch;color:color-mix(in srgb,var(--color-text) 88%,transparent);border-left:2px solid var(--green);padding-left:14px">Please do not include medical details here. We can talk about those on the call.</p>
        </div>

        <div style="border:1px solid var(--color-divider);border-radius:var(--radius-md);padding:calc(1.25*var(--leading))">
          <!-- Progress bar -->
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:var(--leading)">
            <span data-bar="1" style="height:2px;flex:1;background:var(--green)"></span>
            <span data-bar="2" style="height:2px;flex:1;background:var(--color-divider)"></span>
            <span data-bar="3" style="height:2px;flex:1;background:var(--color-divider)"></span>
            <span data-steplabel style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);white-space:nowrap;font-feature-settings:'tnum' 1">Step 1 of 3</span>
          </div>

          <noscript>
            <p style="font-size:17px;line-height:28px;margin:0 0 var(--leading);padding:12px 14px;border:1px solid var(--color-divider);border-radius:var(--radius-md)">To book a free call, {site.emailLive && (<>email <a href={`mailto:${site.email}`}>{site.email}</a>, </>)}call <a href={site.phoneHref}>{site.phone}</a>, or message on <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>. Tell us who it's for, your city, and the best time and language to reach you.</p>
          </noscript>
          <form name="booking" method="POST" id="booking-form" novalidate data-endpoint={site.formEndpoint} data-email={site.emailLive ? site.email : ''} data-phone={site.phone}>
            <p hidden aria-hidden="true"><label>Leave this field blank<input name="company" tabindex="-1" autocomplete="off" /></label></p>

            <!-- STEP 1 -->
            <div class="form-step" data-step="1">
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:21px;line-height:1.3;margin:0">Who is this for?</p>
                <div class="field">
                  <label for="a-rel">This is for</label>
                  <select class="input" id="a-rel" name="relationship" data-other="Other">
                    <option>My mother</option><option>My father</option><option>Both parents</option>
                    <option>Another relative</option><option>Myself</option><option>A client or congregant of mine</option><option>Other</option>
                  </select>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-4)">
                  <div class="field">
                    <label for="a-age">Their age</label>
                    <input class="input" id="a-age" name="age" type="text" inputmode="numeric" placeholder="78" />
                  </div>
                  <div class="field">
                    <label for="a-city">City</label>
                    <select class="input" id="a-city" name="city" data-other="Other">
                      <option>Monrovia</option><option>Arcadia</option><option>Pasadena</option><option>Duarte</option>
                      <option>Temple City</option><option>Rosemead or San Gabriel</option><option>Alhambra</option>
                      <option>Covina or West Covina</option>
                      <option>Other</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="a-mob">Moving around</label>
                  <select class="input" id="a-mob" name="mobility">
                    <option>On their own</option><option>With an arm to hold or a family member's help</option>
                    <option>They would need to be lifted or carried</option>
                  </select>
                  <span style="font-size:13px;line-height:22px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">This only tells me whether I can help. I am not able to lift, carry or transfer anyone. Please do not add medical details.</span>
                </div>
                <p data-lift-warning hidden style="margin:0;font-size:15px;line-height:23px;color:var(--color-accent-700);border:1px solid var(--color-accent);border-radius:var(--radius-md);padding:12px 14px">Please send it in anyway. On the call we will explain what we can cover and who to contact for the rest.</p>
                <div class="field">
                  <span style="font-size:13px;letter-spacing:0.04em">Companion preference</span>
                  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;margin-top:6px">
                    <label class="radio" style="cursor:pointer"><input type="radio" name="companion" value="A woman" checked /><span class="dot"></span>A woman</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="companion" value="No preference" /><span class="dot"></span>No preference</label>
                  </div>
                  <p style="font-size:15px;line-height:23px;margin:8px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">At present, visits are with a woman. If your parent would prefer a man, please tell me on the call.</p>
                </div>
                <div><button type="button" class="btn btn-primary" data-next>Next</button></div>
              </div>
            </div>

            <!-- STEP 2 -->
            <div class="form-step" data-step="2" hidden>
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:21px;line-height:1.3;margin:0">What does the week need?</p>
                <div class="field">
                  <span style="font-size:13px;letter-spacing:0.04em">Which day works better</span>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px" data-days>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Sat">Saturday</button>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Sun">Sunday</button>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Either">Either</button>
                  </div>
                  <input type="hidden" name="days" id="a-days" value="" />
                </div>
                <div class="field">
                  <label for="a-hours">Hours you have in mind</label>
                  <select class="input" id="a-hours" name="hours">
                    <option>About 2 hrs · Chai</option><option>About 4 hrs · Dawat</option>
                    <option>About 8 hrs · Ghar</option><option>Not sure yet, help me work it out</option>
                  </select>
                </div>
                <div class="field">
                  <label for="a-need">What help do you need most?</label>
                  <textarea class="input" id="a-need" name="need" rows="4" style="resize:vertical;font-family:var(--font-body);line-height:24px" placeholder="Nobody nearby to sit with her on weekends anymore, and the pharmacy calls keep piling up."></textarea>
                </div>
                <div class="field">
                  <label for="a-before">Have you used something like this before?</label>
                  <select class="input" id="a-before" name="experience">
                    <option>No, this is the first time</option><option>Yes, an agency</option>
                    <option>Yes, someone from the community</option><option>We tried and it didn't work out</option>
                  </select>
                </div>
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap">
                  <button type="button" class="btn btn-ghost" data-back>Back</button>
                  <button type="button" class="btn btn-primary" data-next>Next</button>
                </div>
              </div>
            </div>

            <!-- STEP 3 -->
            <div class="form-step" data-step="3" hidden>
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:21px;line-height:1.3;margin:0">How do we reach you?</p>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-4)">
                  <div class="field" data-field="name">
                    <label for="a-name">Your name</label>
                    <input class="input" id="a-name" name="name" type="text" autocomplete="name" placeholder="Ayesha" required aria-describedby="err-name" />
                    <span class="field-error" id="err-name">We need a name to ask for.</span>
                  </div>
                  <div class="field" data-field="phone">
                    <label for="a-phone">Phone</label>
                    <input class="input" id="a-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(626) 555 0142" required aria-describedby="err-phone" />
                    <span class="field-error" id="err-phone">Please enter a number we can call.</span>
                  </div>
                </div>
                <div class="field">
                  <label for="a-email">Email, if you'd rather</label>
                  <input class="input" id="a-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="err-email" />
                  <span class="field-error" id="err-email">That email doesn't look right. Check it over.</span>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-4)">
                  <div class="field">
                    <label for="a-when">Best time to call</label>
                    <select class="input" id="a-when" name="best_time">
                      <option>Mornings</option><option>Afternoons</option><option>Evenings after 6</option><option>Weekends</option><option>Any time</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="a-heard">How did you hear about us?</label>
                    <select class="input" id="a-heard" name="heard" data-other="Somewhere else">
                      <option>From the masjid</option><option>From a friend or relative</option><option>A community WhatsApp group</option>
                      <option>Instagram or Facebook</option><option>Search</option><option>Somewhere else</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <span style="font-size:13px;letter-spacing:0.04em">Language for the call</span>
                  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;margin-top:6px">
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Urdu" checked /><span class="dot"></span>Urdu</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="English" /><span class="dot"></span>English</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Hindi" /><span class="dot"></span>Hindi</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Either" /><span class="dot"></span>Either</label>
                  </div>
                </div>
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:center">
                  <button type="button" class="btn btn-ghost" data-back>Back</button>
                  <button type="submit" class="btn btn-primary" data-submit>Send it</button>
                </div>
                <span style="font-size:13px;line-height:22px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We don't share anything you write here with anyone outside Apna.</span>
              </div>
            </div>

            <!-- DONE -->
            <div class="form-step" data-step="done" hidden aria-live="polite">
              <div style="display:flex;flex-direction:column;gap:14px">
                <span style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green)">Sent</span>
                <p data-thanks style="font-family:var(--font-heading);font-size:26px;line-height:1.3;margin:0">Thank you.</p>
                <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">I'll call <span data-shown-phone>you</span>, <span data-shown-when>at a good time</span>. For anything urgent, call or text <a href={site.phoneHref}>{site.phone}</a> and I'll get back to you as soon as I can.</p>
                <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">The initial thirty-minute consultation is free. Nothing is charged unless you decide to continue.</p>
                <div><button type="button" class="btn btn-ghost" data-restart>Send another</button></div>
              </div>
            </div>
          </form>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="Referrals" style="padding:calc(1.2*var(--leading)) 0 calc(1.6*var(--leading))">
        <p style="display:block;font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--green);margin:0 0 10px">Know a family who could use this?</p>
        <p style="font-size:16px;line-height:25px;margin:0;max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We grow through word of mouth. If you know a family who could use our help, we would be grateful for an introduction. When a family you introduce becomes a client, you both receive 10% off the hourly rate on companion visits for two months. You are welcome to share <a href={site.url}>{site.url.replace('https://', '')}</a> or <a href={site.phoneHref}>{site.phone}</a>.</p>
      </section>
    </div>
  </main>

  <div class="ornament-strip" aria-hidden="true"></div>

  <footer style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg))">
    <div style="max-width:1180px;margin:0 auto;padding:calc(2*var(--leading)) var(--edge);display:flex;flex-wrap:wrap;gap:var(--leading) calc(2*var(--leading));justify-content:space-between;font-size:13px;line-height:22px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">
      <div style="max-width:64ch">
        <p style="margin:0 0 10px;color:var(--color-text);font-family:var(--font-heading);font-size:19px">Apna Senior Concierge · San Gabriel Valley, California</p>
        <p style="margin:0 0 12px">Non-medical companion and errand services. Apna is not a licensed home care organization, home health agency, hospice or charter-party carrier. We provide no medical, nursing, legal, immigration or financial services or advice, and do not administer medication, injections or wound care. We do not lift, carry or transfer clients, and provide no hands-on personal care such as bathing, dressing or toileting. There is no medical transport: no gurney, wheelchair lift, or in-transit monitoring. Driving is provided as part of hourly companion visits and is not sold as a separate fare. Services are open to everyone in the service area regardless of faith, national origin, disability or any other characteristic protected under California law.</p>
        <p style="margin:0"><a href="/privacy/" style="color:var(--color-accent-700)">Privacy Policy</a> &nbsp;·&nbsp; <a href="/terms/" style="color:var(--color-accent-700)">Terms of Service</a></p>
      </div>
      <div style="display:flex;flex-direction:column;gap:7px">
        {site.emailLive && <a href={`mailto:${site.email}`} style="text-decoration:none">{site.email}</a>}
        <a href={site.phoneHref} style="text-decoration:none">{site.phone}</a>
      </div>
    </div>
  </footer>

  <script>
    // ── Booking form: step navigation, validation, spam-safe Netlify submit ──
    const form = document.getElementById('booking-form');
    if (form) {
      const steps = ['1', '2', '3'];
      let current = 0;

      const stepEls = new Map();
      form.querySelectorAll('.form-step').forEach((el) => {
        stepEls.set(el.getAttribute('data-step'), el);
      });
      const bars = [1, 2, 3].map((n) => document.querySelector(`[data-bar="${n}"]`));
      const stepLabel = document.querySelector('[data-steplabel]');

      function show(key) {
        stepEls.forEach((el, k) => { el.hidden = k !== key; });
        if (key === '1' || key === '2' || key === '3') {
          const idx = Number(key);
          bars.forEach((b, i) => {
            if (b) b.style.background = i < idx ? 'var(--green)' : 'var(--color-divider)';
          });
          if (stepLabel) stepLabel.textContent = `Step ${key} of 3`;
        }
      }

      // Lift warning
      const mob = form.querySelector('#a-mob');
      const lift = form.querySelector('[data-lift-warning]');
      function syncLift() {
        if (lift && mob) lift.hidden = mob.value !== 'They would need to be lifted or carried';
      }
      mob && mob.addEventListener('change', syncLift);
      syncLift();

      // Day toggles → hidden input
      const daysInput = form.querySelector('#a-days');
      form.querySelectorAll('.day-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const on = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', on ? 'false' : 'true');
          const picked = Array.from(form.querySelectorAll('.day-toggle[aria-pressed="true"]'))
            .map((b) => b.getAttribute('data-day'));
          if (daysInput) daysInput.value = picked.join(', ');
        });
      });

      // Validation helpers
      function setError(fieldName, on) {
        const wrap = form.querySelector(`[data-field="${fieldName}"]`);
        if (wrap) wrap.classList.toggle('has-error', on);
        return !on;
      }
      function validateStep3() {
        const name = form.querySelector('#a-name');
        const phone = form.querySelector('#a-phone');
        const email = form.querySelector('#a-email');
        let ok = true;
        ok = setError('name', !(name && name.value.trim().length > 0)) && ok;
        const digits = (phone && phone.value.replace(/\D/g, '')) || '';
        ok = setError('phone', digits.length < 10) && ok;
        // email optional, but if present must be plausible
        const emailWrap = email && email.closest('.field');
        if (email && email.value.trim()) {
          const good = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
          emailWrap && emailWrap.classList.toggle('has-error', !good);
          ok = good && ok;
        } else if (emailWrap) {
          emailWrap.classList.remove('has-error');
        }
        return ok;
      }

      form.querySelectorAll('[data-next]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (current < steps.length - 1) { current += 1; show(steps[current]); }
        })
      );
      form.querySelectorAll('[data-back]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (current > 0) { current -= 1; show(steps[current]); }
        })
      );

      const endpoint = form.dataset.endpoint || '';
      const contactEmail = form.dataset.email || '';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot: a bot filled the hidden field — silently accept, send nothing.
        const hp = form.querySelector('[name="company"]');
        if (hp && hp.value) { show('done'); return; }

        if (!validateStep3()) {
          const bad = form.querySelector('.field.has-error .input');
          bad && bad.focus();
          return;
        }
        const submitBtn = form.querySelector('[data-submit]');
        submitBtn && (submitBtn.disabled = true);

        const fields = Object.fromEntries(new FormData(form).entries());
        delete fields.company;

        if (endpoint) {
          // Automatic delivery to a configured endpoint (e.g. a Supabase function).
          let failed = false;
          try {
            const res = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(fields),
            });
            if (!res.ok) failed = true;
          } catch (err) {
            failed = true;
          }
          if (failed) {
            // Never tell a family it worked when it did not.
            submitBtn && (submitBtn.disabled = false);
            let err = form.querySelector('[data-submit-error]');
            if (!err) {
              err = document.createElement('p');
              err.setAttribute('data-submit-error', '');
              err.setAttribute('role', 'alert');
              err.style.cssText = 'margin:12px 0 0;font-size:15px;line-height:23px;color:var(--color-accent-700)';
              (submitBtn ? submitBtn.parentElement : form).appendChild(err);
            }
            err.textContent = 'Sorry, something went wrong and your request was not sent. Please call or text us at ' + (form.dataset.phone || '') + ' and we will take it from there.';
            return;
          }
        } else if (contactEmail) {
          // No endpoint configured: open the visitor's mail app, pre-filled.
          const order = [
            ['name', 'Name'], ['phone', 'Phone'], ['email', 'Email'],
            ['relationship', 'This is for'], ['age', 'Age'], ['city', 'City'],
            ['mobility', 'Moving around'], ['companion', 'Companion preference'],
            ['days', 'Days that matter'], ['hours', 'Hours in mind'],
            ['experience', 'Used before'], ['best_time', 'Best time to call'],
            ['language', 'Language for the call'], ['heard', 'Heard about us'],
          ];
          const lines = order
            .filter(([k]) => fields[k])
            .map(([k, label]) => `${label}: ${fields[k]}`);
          if (fields.need) lines.push('', "What's going unhandled:", fields.need);
          const subject = `Apna booking request: ${fields.name || 'new enquiry'}`;
          window.location.href =
            'mailto:' + contactEmail +
            '?subject=' + encodeURIComponent(subject) +
            '&body=' + encodeURIComponent(lines.join('\n'));
        }

        const phoneVal = (form.querySelector('#a-phone').value || '').trim();
        const whenVal = (form.querySelector('#a-when').value || '').toLowerCase();
        const nameVal = (form.querySelector('#a-name').value || '').trim();
        const sp = document.querySelector('[data-shown-phone]');
        const sw = document.querySelector('[data-shown-when]');
        const th = document.querySelector('[data-thanks]');
        if (sp) sp.textContent = phoneVal || 'you';
        if (sw) sw.textContent = whenVal || 'at a good time';
        if (th && nameVal) th.textContent = `Thank you, ${nameVal.split(' ')[0]}.`;
        show('done');
      });

      form.querySelector('[data-restart]')?.addEventListener('click', () => {
        form.reset();
        form.querySelectorAll('.field.has-error').forEach((f) => f.classList.remove('has-error'));
        form.querySelectorAll('.day-toggle[aria-pressed="true"]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        if (daysInput) daysInput.value = '';
        syncLift();
        const submitBtn = form.querySelector('[data-submit]');
        submitBtn && (submitBtn.disabled = false);
        current = 0; show('1');
      });
    }
  </script>
  <script is:inline>
    // Highlight the nav link for the section currently on screen.
    (function () {
      var ids = ['help', 'plans', 'estate', 'about', 'questions', 'book'];
      var items = ids.map(function (id) {
        return { el: document.getElementById(id), link: document.querySelector('.nav a[href="#' + id + '"]') };
      }).filter(function (x) { return x.el && x.link; });
      var queued = false;
      function update() {
        queued = false;
        var active = null;
        items.forEach(function (x) { if (x.el.getBoundingClientRect().top <= 140) active = x; });
        items.forEach(function (x) {
          if (x === active) x.link.setAttribute('aria-current', 'location');
          else x.link.removeAttribute('aria-current');
        });
      }
      function onScroll() { if (!queued) { queued = true; requestAnimationFrame(update); } }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('hashchange', onScroll);
      update();
    })();
  </script>
</Layout>
