---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
import { hero } from '../data/hero';
import { services } from '../data/services';
import { plans } from '../data/plans';
import { faq } from '../data/faq';
import { testimonials } from '../data/testimonials';
import { team } from '../data/team';
---
<Layout>
  <nav class="nav" aria-label="Primary" style="position:sticky;top:0;z-index:30;background:var(--color-bg);flex-wrap:wrap;row-gap:8px;border-bottom:1px solid var(--color-divider);padding-inline:max(var(--edge),calc((100% - 1180px)/2 + var(--edge)))">
    <a class="nav-brand" href="/" aria-label="Apna Senior Concierge home" style="display:flex;align-items:center;gap:11px;text-decoration:none;color:inherit">
      <img src="/apna-logo.svg" alt="Apna Senior Concierge" height="52" style="display:block;height:52px;width:auto" />
    </a>
    <a href="#help" style="white-space:nowrap;font-size:15px;text-decoration:none">What we do</a>
    <a href="#plans" style="white-space:nowrap;font-size:15px;text-decoration:none">Plans</a>
    <a href="#about" style="white-space:nowrap;font-size:15px;text-decoration:none">About</a>
    <a href="#questions" style="white-space:nowrap;font-size:15px;text-decoration:none">FAQ</a>
    <a href="/portal/login" style="white-space:nowrap;font-size:15px;text-decoration:none;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Client portal</a>
    <a class="btn btn-primary" href="#book" style="white-space:nowrap">Book a call</a>
  </nav>

  <main id="main">
    <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
      <section style="min-height:calc(100svh - 88px);display:flex;flex-direction:column;justify-content:center;padding:calc(2*var(--leading)) 0">
        <h1 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(42px,5.6vw,78px);line-height:1.08;letter-spacing:-0.012em;margin:calc(1.25*var(--leading)) 0 0 -0.042em;max-width:22ch">
          {hero.headlineLines.map((line) => (
            <span style={`display:block${line.italic ? ';font-style:italic;color:var(--green)' : ''}`}>{line.text}</span>
          ))}
        </h1>
        <p style="font-family:var(--font-heading);font-weight:400;font-size:clamp(21px,2.4vw,28px);line-height:1.5;margin:calc(0.9*var(--leading)) 0 0;max-width:52ch;color:color-mix(in srgb,var(--color-text) 92%,transparent)">{hero.subhead}</p>
        <div style="margin-top:calc(1.3*var(--leading));display:flex;gap:14px;flex-wrap:wrap">
          <a class="btn btn-primary" href={hero.ctaPrimary.href} style="font-size:17px;padding:12px 22px">{hero.ctaPrimary.label}</a>
          <a class="btn btn-ghost" href={hero.ctaSecondary.href} style="font-size:17px">{hero.ctaSecondary.label}</a>
        </div>
      </section>

      <section aria-label="In short" style="padding:0 0 calc(2*var(--leading))">
        <div aria-hidden="true" style="display:flex;align-items:center;gap:14px;margin-top:calc(1.1*var(--leading))">
          <span style="height:1px;flex:1;background:var(--color-divider)"></span>
          <span style="width:26px;height:26px;background-image:var(--tile);background-size:26px 26px;opacity:0.7"></span>
          <span style="height:1px;flex:1;background:var(--color-divider)"></span>
        </div>
        <div style="margin-top:calc(1.5*var(--leading))">
          <p style="font-size:19px;line-height:var(--leading);margin:0;max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Apna is a concierge service for older adults in the San Gabriel Valley. We offer companionship, errands and transportation assistance, and we stay for as long as the visit requires. It is the help a child would give if they were able to.</p>
          <p style="font-size:17px;line-height:28px;margin:var(--leading) 0 0;max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent);border-left:2px solid var(--green);padding-left:14px">We currently offer Urdu, Hindi, English and Memoni. We are working to add more languages as families ask for them.</p>
        </div>
      </section>
    </div>

    <div class="ornament-strip" aria-hidden="true"></div>

    <section aria-label="Reflection" style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg));position:relative;overflow:hidden">
      <div aria-hidden="true" style="position:absolute;inset:0;background-image:var(--tile);background-size:88px 88px;opacity:0.16;pointer-events:none"></div>
      <div style="max-width:1180px;margin:0 auto;padding:calc(2.5*var(--leading)) var(--edge);position:relative;text-align:center">
        <p lang="ar" dir="rtl" style="font-family:'Noto Naskh Arabic',serif;font-size:clamp(28px,3.2vw,40px);line-height:2.1;margin:0;color:var(--green-deep);max-width:24ch;margin-inline:auto">وَٱخْفِضْ لَهُمَا جَنَاحَ ٱلذُّلِّ مِنَ ٱلرَّحْمَةِ وَقُل رَّبِّ ٱرْحَمْهُمَا كَمَا رَبَّيَانِى صَغِيرًا</p>
        <p style="font-family:var(--font-heading);font-size:clamp(21px,2.4vw,28px);line-height:1.5;margin:var(--leading) auto 0;max-width:36ch;color:var(--color-text)">“And lower to them the wing of humility out of mercy, and say: my Lord, have mercy upon them as they raised me when I was small.”</p>
        <p style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;margin:18px 0 0;color:var(--green);font-feature-settings:'tnum' 1">Qur'an 17:24</p>
      </div>
    </section>

    <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
      <section id="help" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">What we do</p>
        <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0 0 var(--leading);max-width:22ch">Help with the week, without anyone having to ask.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:0 calc(2*var(--leading))">
          {services.map((s) => (
            <div style="border-top:1px solid var(--color-divider);padding:16px 0">
              <h3 style="font-family:var(--font-heading);font-weight:400;font-size:21px;margin:0 0 6px">{s.title}</h3>
              <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{s.body}</p>
            </div>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="How it starts" style="padding:calc(2.5*var(--leading)) 0">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 var(--leading)">How it starts</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(400px,1fr));gap:calc(1.5*var(--leading)) calc(2*var(--leading))">
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">One</span>
            <h3 class="card-title" style="font-weight:400">A free call</h3>
            <p class="card-body" style="line-height:24px;margin:0">Twenty minutes by phone, in the language you prefer. We ask what help is already in place and where it falls short.</p>
          </div>
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">Two</span>
            <h3 class="card-title" style="font-weight:400">We meet your parent</h3>
            <p class="card-body" style="line-height:24px;margin:0">A free thirty-minute consultation over chai, before anything is booked. If it is not the right fit, we will say so.</p>
          </div>
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">Three</span>
            <h3 class="card-title" style="font-weight:400">A plan built around your week</h3>
            <p class="card-body" style="line-height:24px;margin:0">You choose a plan and we agree on regular days and hours, set out in a written agreement before visits begin.</p>
          </div>
          <div class="card">
            <span class="card-kicker" style="font-feature-settings:'tnum' 1;color:var(--green)">Four</span>
            <h3 class="card-title" style="font-weight:400">Visits you can count on</h3>
            <p class="card-body" style="line-height:24px;margin:0">Visits take place at the agreed time each week, and you receive a note after each one.</p>
          </div>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="How you'll know" style="padding:calc(2.5*var(--leading)) 0">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">How you'll know</p>
        <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0 0 var(--leading);max-width:22ch">"How do I know my parent is okay?"</h2>
        <p style="font-size:17px;line-height:28px;margin:0 0 var(--leading);max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">It is the first question most families ask. After each visit, you receive a written note.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px 40px;max-width:820px">
          <span style="font-size:17px;line-height:28px">✓ What we did and how the visit went</span>
          <span style="font-size:17px;line-height:28px">✓ How your parent seemed that day</span>
          <span style="font-size:17px;line-height:28px">✓ A photo, with your parent's permission</span>
          <span style="font-size:17px;line-height:28px">✓ When we'll be back next</span>
          <span style="font-size:17px;line-height:28px">✓ Anything that needs your attention</span>
        </div>
      </section>

      <section aria-label="Everything in one place" style="padding:0 0 calc(2.5*var(--leading))">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Everything in one place</p>
        <p style="font-size:17px;line-height:28px;margin:0;max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Clients have a private account showing visit history, the upcoming schedule and invoices. Schedule changes can be requested from a phone at any time. <a href="/portal/login">See the client portal &rarr;</a></p>
      </section>

      <hr class="hr" />

      <section id="plans" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <div style="display:flex;flex-wrap:wrap;gap:14px calc(2*var(--leading));align-items:baseline;justify-content:space-between">
          <div>
            <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Three plans</p>
            <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:20ch">Choose the amount of support that suits your family.</h2>
          </div>
          <p style="font-size:17px;line-height:28px;margin:0;max-width:34ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Most families begin with one of these three plans and we adjust from there. Every visit is at least two hours, at rates starting at $50 an hour.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:calc(1.5*var(--leading)) calc(1.5*var(--leading));margin-top:calc(1.5*var(--leading));align-items:stretch">
          {plans.map((plan) => (
            <div class={`card${plan.highlighted ? ' elev-sm' : ''}`} style={`padding:calc(1.25*var(--leading));gap:0;display:flex;flex-direction:column${plan.highlighted ? ';border-color:var(--green)' : ''}`}>
              <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;min-height:28px">
                <h3 style="font-family:var(--font-heading);font-weight:400;font-size:26px;line-height:1.2;margin:0">{plan.name}</h3>
                {plan.badge && <span style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);border:1px solid var(--green);border-radius:var(--radius-sm);padding:3px 8px;white-space:nowrap">{plan.badge}</span>}
              </div>
              <span style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin-top:6px">{plan.hoursLabel.toUpperCase()}</span>
              <p style="font-size:17px;line-height:28px;margin:16px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{plan.description}</p>
              <div style="margin-top:20px;margin-bottom:20px;border-top:1px solid var(--color-divider);padding-top:16px">
                <p style="font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--green);margin:0 0 12px">{plan.featuresHeader}</p>
                <div style="display:flex;flex-direction:column;gap:12px">
                  {plan.features.map((f) => (
                    <span style={`font-size:17px;line-height:28px${f.muted ? ';color:color-mix(in srgb,var(--color-text) 88%,transparent)' : ''}`}>{f.text}</span>
                  ))}
                </div>
              </div>
              <a class="btn btn-primary" href="#book" style="margin-top:auto;width:100%;font-size:17px;padding:16px 20px">{plan.ctaLabel}</a>
            </div>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="What a companion does, and the driving" style="padding:calc(2.5*var(--leading)) 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,88px);align-items:start">
        <div>
          <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">What a companion does</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px">
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Picking up groceries and putting them away, even when your parent does not come along</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Reading and explaining mail, forms and letters</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Cooking together and sharing a meal</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Medication reminders only; we do not handle doses</span></li>
            <li style="font-size:17px;line-height:28px;display:grid;grid-template-columns:14px 1fr;gap:12px"><span aria-hidden="true" style="color:var(--color-accent);line-height:28px">·</span><span>Driving to where they need to go and staying with them <span style="color:var(--green)">(Dawat and Ghar)</span></span></li>
          </ul>
        </div>
        <div>
          <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">The driving</p>
          <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.25;margin:0;max-width:18ch">We drive, and we stay with them.</h2>
          <p style="font-size:17px;line-height:var(--leading);margin:16px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">A rideshare leaves your parent at the bank counter with a form they may not fully follow. We park, go in, sit with them, help with the paperwork and drive home by way of the market. It is one visit, billed by the hour.</p>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="Why families pick us" style="padding:calc(2.5*var(--leading)) 0">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Why families pick us</p>
        <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0 0 var(--leading);max-width:24ch">What matters to our families.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0 calc(2*var(--leading))">
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">The language</h3><p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Conversation in your parent's own language, so nothing has to be relayed through a grandchild.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Salah</h3><p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Visits are planned around prayer times. If we are out, we find a clean place to pray and wait.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Adab of the house</h3><p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We take our shoes off at the door, address elders with respect and leave the kitchen as we found it.</p></div>
          <div style="border-top:1px solid var(--color-divider);padding:16px 0"><h3 style="font-family:var(--font-heading);font-weight:400;font-size:19px;margin:0 0 5px">Asking is the hard part</h3><p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Many elders were not raised to ask for help. We do not make anyone repeat a request, and we do not make it awkward.</p></div>
        </div>
      </section>
    </div>

    <div class="ornament-strip" aria-hidden="true"></div>

    <section id="about" style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg));scroll-margin-top:76px">
      <div style="max-width:1180px;margin:0 auto;padding:calc(2.5*var(--leading)) var(--edge)">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">About</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,88px);align-items:start">
          <div>
            <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:18ch">{team[0].headline}</h2>
            {team[0].bioParagraphs.map((p, i) => (
              <p style={`font-size:17px;line-height:var(--leading);margin:${i === 0 ? '20px' : '18px'} 0 0;max-width:52ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)`}>{p}</p>
            ))}
            <p style="font-family:var(--font-heading);font-size:21px;line-height:1.4;margin:22px 0 0">{team[0].name}<span style="display:block;font-family:var(--font-body);font-size:15px;color:color-mix(in srgb,var(--color-text) 88%,transparent);margin-top:4px">{team[0].role}</span></p>
          </div>
          <div style="display:flex;flex-direction:column;gap:var(--leading)">
            <div>
              <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 10px">How to check us out</p>
              <p style="font-size:15px;line-height:23px;margin:0;max-width:40ch;color:color-mix(in srgb,var(--color-text) 78%,transparent)">Meet us before you commit to anything. There is nothing to sign at the consultation.</p>
              <p style="font-size:15px;line-height:23px;margin:12px 0 0;max-width:40ch;color:color-mix(in srgb,var(--color-text) 78%,transparent)">If you decide to continue, we put a written agreement in place covering rates, scope and terms. Visits can be moved or cancelled with 24 hours' notice. Please ask us anything not covered here.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="ornament-strip" aria-hidden="true"></div>

    {testimonials.length > 0 && (
      <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
        <section aria-label="What families say" style="padding:calc(2.5*var(--leading)) 0">
          <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">What families say</p>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:calc(1.5*var(--leading)) calc(2*var(--leading))">
            {testimonials.map((t) => (
              <div style="border-top:1px solid var(--color-divider);padding:18px 0">
                <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">"{t.quote}"</p>
                <p style="font-family:var(--font-heading);font-size:17px;margin:14px 0 0">{t.name}{t.relation && <span style="display:block;font-family:var(--font-body);font-size:13px;color:color-mix(in srgb,var(--color-text) 88%,transparent);margin-top:2px">{t.relation}</span>}</p>
              </div>
            ))}
          </div>
        </section>
        <hr class="hr" />
      </div>
    )}

    <div style="max-width:1180px;margin:0 auto;padding:0 var(--edge)">
      <section id="questions" aria-label="Frequently asked questions" style="padding:calc(2.5*var(--leading)) 0;scroll-margin-top:76px">
        <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 var(--leading)">Frequently asked questions</p>
        <div style="max-width:78ch">
          {faq.map((item, i) => (
            <details style={`border-top:1px solid var(--color-divider)${i === faq.length - 1 ? ';border-bottom:1px solid var(--color-divider)' : ''}`}>
              <summary style="cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 0;font-family:var(--font-heading);font-size:19px;line-height:1.35">{item.question}<span class="chev" aria-hidden="true" style="flex:none;width:9px;height:9px;border-right:1px solid var(--green);border-bottom:1px solid var(--green);transform:rotate(45deg);transition:transform .2s"></span></summary>
              <p style="font-size:17px;line-height:28px;margin:0 0 18px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <hr class="hr" />

      <section id="book" style="padding:calc(2.5*var(--leading)) 0 calc(2*var(--leading));scroll-margin-top:76px;display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:calc(1.5*var(--leading)) clamp(32px,6vw,80px);align-items:start">
        <div>
          <p style="display:block;font-size:13px;line-height:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:0 0 14px">Book a free call</p>
          <h2 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.2;margin:0;max-width:18ch">Tell us about the week you're trying to cover.</h2>
          <p style="font-size:17px;line-height:var(--leading);margin:18px 0 0;max-width:44ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">Three short steps, about two minutes. We will call you back when we can, in the language you prefer. Nothing is booked or charged from this form.</p>
          <p style="font-size:15px;line-height:23px;margin:var(--leading) 0 0;max-width:40ch;color:color-mix(in srgb,var(--color-text) 88%,transparent);border-left:2px solid var(--green);padding-left:14px">Please do not include medical details here. We can discuss those on the call.</p>
        </div>

        <div style="border:1px solid var(--color-divider);border-radius:var(--radius-md);padding:calc(1.25*var(--leading))">
          <!-- Progress bar -->
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:var(--leading)">
            <span data-bar="1" style="height:2px;flex:1;background:var(--green)"></span>
            <span data-bar="2" style="height:2px;flex:1;background:var(--color-divider)"></span>
            <span data-bar="3" style="height:2px;flex:1;background:var(--color-divider)"></span>
            <span data-steplabel style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);white-space:nowrap;font-feature-settings:'tnum' 1">Step 1 of 3</span>
          </div>

          <noscript>
            <p style="font-size:17px;line-height:28px;margin:0 0 var(--leading);padding:12px 14px;border:1px solid var(--color-divider);border-radius:var(--radius-md)">To book a free call, email <a href={`mailto:${site.email}`}>{site.email}</a>, call <a href={site.phoneHref}>{site.phone}</a>, or message on <a href={site.whatsappHref} target="_blank" rel="noopener">WhatsApp</a>. Tell us who it's for, your city, and the best time and language to reach you.</p>
          </noscript>
          <form name="booking" method="POST" id="booking-form" novalidate data-endpoint={site.formEndpoint} data-email={site.email}>
            <p hidden aria-hidden="true"><label>Leave this field blank<input name="company" tabindex="-1" autocomplete="off" /></label></p>

            <!-- STEP 1 -->
            <div class="form-step" data-step="1">
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:21px;line-height:1.3;margin:0">Who is this for?</p>
                <div class="field">
                  <label for="a-rel">This is for</label>
                  <select class="input" id="a-rel" name="relationship">
                    <option>My mother</option><option>My father</option><option>Both parents</option>
                    <option>Another relative</option><option>Myself</option><option>A client or congregant of mine</option>
                  </select>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:var(--space-4)">
                  <div class="field">
                    <label for="a-age">Their age</label>
                    <input class="input" id="a-age" name="age" type="text" inputmode="numeric" placeholder="78" />
                  </div>
                  <div class="field">
                    <label for="a-city">City</label>
                    <select class="input" id="a-city" name="city">
                      <option>Monrovia</option><option>Arcadia</option><option>Pasadena</option><option>Duarte</option>
                      <option>Temple City</option><option>Rosemead or San Gabriel</option><option>Alhambra</option>
                      <option>Covina or West Covina</option><option>Elsewhere in the SGV</option><option>Orange County</option>
                      <option>Somewhere else</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="a-mob">Getting around</label>
                  <select class="input" id="a-mob" name="mobility">
                    <option>Walks on their own</option><option>Walks slowly, prefers an arm</option><option>Uses a cane</option>
                    <option>Uses a walker</option><option>Uses a wheelchair, transfers themselves</option>
                    <option>Uses a wheelchair, needs help transferring</option>
                  </select>
                  <span style="font-size:13px;line-height:22px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We are not able to lift, carry or transfer anyone.</span>
                </div>
                <p data-lift-warning hidden style="margin:0;font-size:15px;line-height:23px;color:var(--color-accent-700);border:1px solid var(--color-accent);border-radius:var(--radius-md);padding:12px 14px">Please send it in anyway. On the call we will explain what we can cover and who to contact for the rest.</p>
                <div class="field">
                  <span style="font-size:13px;letter-spacing:0.04em">Companion preference</span>
                  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;margin-top:6px">
                    <label class="radio" style="cursor:pointer"><input type="radio" name="companion" value="A woman" checked /><span class="dot"></span>A woman</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="companion" value="No preference" /><span class="dot"></span>No preference</label>
                  </div>
                  <p style="font-size:15px;line-height:23px;margin:8px 0 0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">All of our companions are currently women. If your parent would prefer a man, please tell us on the call and we will let you know whether we can help.</p>
                </div>
                <div><button type="button" class="btn btn-primary" data-next>Next</button></div>
              </div>
            </div>

            <!-- STEP 2 -->
            <div class="form-step" data-step="2" hidden>
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:21px;line-height:1.3;margin:0">What does the week need?</p>
                <div class="field">
                  <span style="font-size:13px;letter-spacing:0.04em">Which day works better</span>
                  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px" data-days>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Sat">Saturday</button>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Sun">Sunday</button>
                    <button type="button" class="tag tag-outline day-toggle" aria-pressed="false" data-day="Either">Either</button>
                  </div>
                  <input type="hidden" name="days" id="a-days" value="" />
                </div>
                <div class="field">
                  <label for="a-hours">Hours you have in mind</label>
                  <select class="input" id="a-hours" name="hours">
                    <option>About 2 hrs · Chai</option><option>About 4 hrs · Dawat</option>
                    <option>About 6 hrs · Ghar</option><option>Not sure yet, help me work it out</option>
                  </select>
                </div>
                <div class="field">
                  <label for="a-need">What help do you need most?</label>
                  <textarea class="input" id="a-need" name="need" rows="4" style="resize:vertical;font-family:var(--font-body);line-height:24px" placeholder="Nobody free to drive on weekends anymore, and the pharmacy calls keep piling up."></textarea>
                </div>
                <div class="field">
                  <label for="a-before">Have you used something like this before?</label>
                  <select class="input" id="a-before" name="experience">
                    <option>No, this is the first time</option><option>Yes, an agency</option>
                    <option>Yes, someone from the community</option><option>We tried and it didn't work out</option>
                  </select>
                </div>
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap">
                  <button type="button" class="btn btn-ghost" data-back>Back</button>
                  <button type="button" class="btn btn-primary" data-next>Next</button>
                </div>
              </div>
            </div>

            <!-- STEP 3 -->
            <div class="form-step" data-step="3" hidden>
              <div style="display:flex;flex-direction:column;gap:var(--space-4)">
                <p style="font-family:var(--font-heading);font-size:21px;line-height:1.3;margin:0">How do we reach you?</p>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-4)">
                  <div class="field" data-field="name">
                    <label for="a-name">Your name</label>
                    <input class="input" id="a-name" name="name" type="text" autocomplete="name" placeholder="Ayesha" required aria-describedby="err-name" />
                    <span class="field-error" id="err-name">We need a name to ask for.</span>
                  </div>
                  <div class="field" data-field="phone">
                    <label for="a-phone">Phone</label>
                    <input class="input" id="a-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(626) 555 0142" required aria-describedby="err-phone" />
                    <span class="field-error" id="err-phone">Please enter a number we can call.</span>
                  </div>
                </div>
                <div class="field">
                  <label for="a-email">Email, if you'd rather</label>
                  <input class="input" id="a-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="err-email" />
                  <span class="field-error" id="err-email">That email doesn't look right. Check it over.</span>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:var(--space-4)">
                  <div class="field">
                    <label for="a-when">Best time to call</label>
                    <select class="input" id="a-when" name="best_time">
                      <option>Mornings</option><option>Afternoons</option><option>Evenings after 6</option><option>Weekends</option><option>Any time</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="a-heard">How did you hear about us?</label>
                    <select class="input" id="a-heard" name="heard">
                      <option>From the masjid</option><option>From a friend or relative</option><option>A community WhatsApp group</option>
                      <option>Instagram or Facebook</option><option>Search</option><option>Somewhere else</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <span style="font-size:13px;letter-spacing:0.04em">Language for the call</span>
                  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;margin-top:6px">
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Urdu" checked /><span class="dot"></span>Urdu</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="English" /><span class="dot"></span>English</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Memoni" /><span class="dot"></span>Memoni</label>
                    <label class="radio" style="cursor:pointer"><input type="radio" name="language" value="Either" /><span class="dot"></span>Either</label>
                  </div>
                </div>
                <div style="display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:center">
                  <button type="button" class="btn btn-ghost" data-back>Back</button>
                  <button type="submit" class="btn btn-primary" data-submit>Send it</button>
                </div>
                <span style="font-size:13px;line-height:22px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We don't share anything you write here with anyone outside Apna.</span>
              </div>
            </div>

            <!-- DONE -->
            <div class="form-step" data-step="done" hidden aria-live="polite">
              <div style="display:flex;flex-direction:column;gap:14px">
                <span style="font-size:13px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green)">Sent</span>
                <p data-thanks style="font-family:var(--font-heading);font-size:26px;line-height:1.3;margin:0">Thank you.</p>
                <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We'll call <span data-shown-phone>you</span>, <span data-shown-when>at a good time</span>. For anything urgent, call or text <a href={site.phoneHref}>{site.phone}</a> and we'll get back to you as soon as we can.</p>
                <p style="font-size:17px;line-height:28px;margin:0;color:color-mix(in srgb,var(--color-text) 88%,transparent)">The initial thirty-minute consultation is free. Nothing is charged unless you decide to continue.</p>
                <div><button type="button" class="btn btn-ghost" data-restart>Send another</button></div>
              </div>
            </div>
          </form>
        </div>
      </section>

      <hr class="hr" />

      <section aria-label="Referrals" style="padding:calc(1.2*var(--leading)) 0 calc(1.6*var(--leading))">
        <p style="display:block;font-size:13px;letter-spacing:0.06em;text-transform:uppercase;color:var(--green);margin:0 0 10px">Know a family who could use this?</p>
        <p style="font-size:16px;line-height:25px;margin:0;max-width:60ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">We grow through word of mouth. If you know a family who could use our help, we would be grateful for an introduction. You are welcome to share <a href={site.url}>{site.url.replace('https://', '')}</a> or <a href={site.phoneHref}>{site.phone}</a>.</p>
      </section>
    </div>
  </main>

  <div class="ornament-strip" aria-hidden="true"></div>

  <footer style="background:color-mix(in srgb, var(--green) 8%, var(--color-bg))">
    <div style="max-width:1180px;margin:0 auto;padding:calc(2*var(--leading)) var(--edge);display:flex;flex-wrap:wrap;gap:var(--leading) calc(2*var(--leading));justify-content:space-between;font-size:13px;line-height:22px;color:color-mix(in srgb,var(--color-text) 88%,transparent)">
      <div style="max-width:64ch">
        <p style="margin:0 0 10px;color:var(--color-text);font-family:var(--font-heading);font-size:19px">Apna Senior Concierge · San Gabriel Valley, California</p>
        <p style="margin:0 0 12px">Non-medical companion, errand and transportation-assistance services. Apna is not a licensed home care organization, home health agency, hospice or charter-party carrier. We provide no medical, nursing, legal, immigration or financial services or advice, and do not administer medication, injections or wound care. We do not lift, carry or transfer clients, and provide no hands-on personal care such as bathing, dressing or toileting. There is no medical transport: no gurney, wheelchair lift, or in-transit monitoring. Driving is provided as part of hourly companion visits and is not sold as a separate fare. Services are open to everyone in the service area regardless of faith, national origin, disability or any other characteristic protected under California law.</p>
        <p style="margin:0"><a href="/privacy/" style="color:var(--color-accent-700)">Privacy Policy</a> &nbsp;·&nbsp; <a href="/terms/" style="color:var(--color-accent-700)">Terms of Service</a></p>
      </div>
      <div style="display:flex;flex-direction:column;gap:7px">
        <a href={`mailto:${site.email}`} style="text-decoration:none">{site.email}</a>
        <a href={site.phoneHref} style="text-decoration:none">{site.phone}</a>
      </div>
    </div>
  </footer>

  <script>
    // ── Booking form: step navigation, validation, spam-safe Netlify submit ──
    const form = document.getElementById('booking-form');
    if (form) {
      const steps = ['1', '2', '3'];
      let current = 0;

      const stepEls = new Map();
      form.querySelectorAll('.form-step').forEach((el) => {
        stepEls.set(el.getAttribute('data-step'), el);
      });
      const bars = [1, 2, 3].map((n) => document.querySelector(`[data-bar="${n}"]`));
      const stepLabel = document.querySelector('[data-steplabel]');

      function show(key) {
        stepEls.forEach((el, k) => { el.hidden = k !== key; });
        if (key === '1' || key === '2' || key === '3') {
          const idx = Number(key);
          bars.forEach((b, i) => {
            if (b) b.style.background = i < idx ? 'var(--green)' : 'var(--color-divider)';
          });
          if (stepLabel) stepLabel.textContent = `Step ${key} of 3`;
        }
      }

      // Lift warning
      const mob = form.querySelector('#a-mob');
      const lift = form.querySelector('[data-lift-warning]');
      function syncLift() {
        if (lift && mob) lift.hidden = mob.value !== 'Uses a wheelchair, needs help transferring';
      }
      mob && mob.addEventListener('change', syncLift);
      syncLift();

      // Day toggles → hidden input
      const daysInput = form.querySelector('#a-days');
      form.querySelectorAll('.day-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const on = btn.getAttribute('aria-pressed') === 'true';
          btn.setAttribute('aria-pressed', on ? 'false' : 'true');
          const picked = Array.from(form.querySelectorAll('.day-toggle[aria-pressed="true"]'))
            .map((b) => b.getAttribute('data-day'));
          if (daysInput) daysInput.value = picked.join(', ');
        });
      });

      // Validation helpers
      function setError(fieldName, on) {
        const wrap = form.querySelector(`[data-field="${fieldName}"]`);
        if (wrap) wrap.classList.toggle('has-error', on);
        return !on;
      }
      function validateStep3() {
        const name = form.querySelector('#a-name');
        const phone = form.querySelector('#a-phone');
        const email = form.querySelector('#a-email');
        let ok = true;
        ok = setError('name', !(name && name.value.trim().length > 0)) && ok;
        const digits = (phone && phone.value.replace(/\D/g, '')) || '';
        ok = setError('phone', digits.length < 10) && ok;
        // email optional, but if present must be plausible
        const emailWrap = email && email.closest('.field');
        if (email && email.value.trim()) {
          const good = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
          emailWrap && emailWrap.classList.toggle('has-error', !good);
          ok = good && ok;
        } else if (emailWrap) {
          emailWrap.classList.remove('has-error');
        }
        return ok;
      }

      form.querySelectorAll('[data-next]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (current < steps.length - 1) { current += 1; show(steps[current]); }
        })
      );
      form.querySelectorAll('[data-back]').forEach((btn) =>
        btn.addEventListener('click', () => {
          if (current > 0) { current -= 1; show(steps[current]); }
        })
      );

      const endpoint = form.dataset.endpoint || '';
      const contactEmail = form.dataset.email || '';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot: a bot filled the hidden field — silently accept, send nothing.
        const hp = form.querySelector('[name="company"]');
        if (hp && hp.value) { show('done'); return; }

        if (!validateStep3()) {
          const bad = form.querySelector('.field.has-error .input');
          bad && bad.focus();
          return;
        }
        const submitBtn = form.querySelector('[data-submit]');
        submitBtn && (submitBtn.disabled = true);

        const fields = Object.fromEntries(new FormData(form).entries());
        delete fields.company;

        if (endpoint) {
          // Automatic delivery to a configured endpoint (e.g. a Supabase function).
          try {
            await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(fields),
            });
          } catch (err) {
            // Don't trap the user if the network hiccups — still confirm.
          }
        } else if (contactEmail) {
          // No endpoint configured: open the visitor's mail app, pre-filled.
          const order = [
            ['name', 'Name'], ['phone', 'Phone'], ['email', 'Email'],
            ['relationship', 'This is for'], ['age', 'Age'], ['city', 'City'],
            ['mobility', 'Getting around'], ['companion', 'Companion preference'],
            ['days', 'Days that matter'], ['hours', 'Hours in mind'],
            ['experience', 'Used before'], ['best_time', 'Best time to call'],
            ['language', 'Language for the call'], ['heard', 'Heard about us'],
          ];
          const lines = order
            .filter(([k]) => fields[k])
            .map(([k, label]) => `${label}: ${fields[k]}`);
          if (fields.need) lines.push('', "What's going unhandled:", fields.need);
          const subject = `Apna booking request: ${fields.name || 'new enquiry'}`;
          window.location.href =
            'mailto:' + contactEmail +
            '?subject=' + encodeURIComponent(subject) +
            '&body=' + encodeURIComponent(lines.join('\n'));
        }

        const phoneVal = (form.querySelector('#a-phone').value || '').trim();
        const whenVal = (form.querySelector('#a-when').value || '').toLowerCase();
        const nameVal = (form.querySelector('#a-name').value || '').trim();
        const sp = document.querySelector('[data-shown-phone]');
        const sw = document.querySelector('[data-shown-when]');
        const th = document.querySelector('[data-thanks]');
        if (sp) sp.textContent = phoneVal || 'you';
        if (sw) sw.textContent = whenVal || 'at a good time';
        if (th && nameVal) th.textContent = `Thank you, ${nameVal.split(' ')[0]}.`;
        show('done');
      });

      form.querySelector('[data-restart]')?.addEventListener('click', () => {
        form.reset();
        form.querySelectorAll('.field.has-error').forEach((f) => f.classList.remove('has-error'));
        form.querySelectorAll('.day-toggle[aria-pressed="true"]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        if (daysInput) daysInput.value = '';
        syncLift();
        const submitBtn = form.querySelector('[data-submit]');
        submitBtn && (submitBtn.disabled = false);
        current = 0; show('1');
      });
    }
  </script>
</Layout>
