---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site';
---
<Layout title={`Page not found — ${site.name}`} description="That page couldn’t be found." noindex={true}>
  <main id="main" style="min-height:calc(100svh - 88px);display:flex;align-items:center;justify-content:center;padding:calc(2*var(--leading)) var(--edge)">
    <div style="max-width:34rem;text-align:center">
      <svg viewBox="0 0 44 44" width="52" height="52" aria-hidden="true" style="margin:0 auto"><g fill="none" stroke="var(--green)" stroke-width="1.25"><rect x="7" y="7" width="30" height="30"></rect><rect x="7" y="7" width="30" height="30" transform="rotate(45 22 22)"></rect><circle cx="22" cy="22" r="7.5" stroke="var(--color-accent)"></circle></g></svg>
      <p style="font-size:14px;letter-spacing:0.09em;text-transform:uppercase;color:var(--green);margin:calc(1.2*var(--leading)) 0 10px">Page not found</p>
      <h1 style="font-family:var(--font-heading);font-weight:400;font-size:clamp(34px,5vw,52px);line-height:1.1;margin:0">This page has wandered off.</h1>
      <p style="font-size:18px;line-height:29px;margin:18px auto 0;max-width:44ch;color:color-mix(in srgb,var(--color-text) 88%,transparent)">The link may be old or mistyped. Let’s get you back to where you can find what you need.</p>
      <div style="margin-top:calc(1.4*var(--leading));display:flex;gap:14px;flex-wrap:wrap;justify-content:center">
        <a class="btn btn-primary" href="/" style="font-size:16px;padding:12px 22px">Back to home</a>
        <a class="btn btn-ghost" href="/#book" style="font-size:16px">Book a free call</a>
      </div>
      <p style="font-size:15px;line-height:24px;margin:calc(1.4*var(--leading)) 0 0;color:color-mix(in srgb,var(--color-text) 70%,transparent)">Or reach us directly at <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={site.phoneHref}>{site.phone}</a></p>
    </div>
  </main>
</Layout>
