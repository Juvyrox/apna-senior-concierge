---
// Shared chrome for every /portal page. Without this, portal pages were
// bare white screens with no Apna branding at all — the one place trust
// matters most (a family looking at their parent's care details).
interface Props {
  backHref?: string;
  backLabel?: string;
  admin?: boolean; // true on any /portal/admin/* page — shows an "Admin" badge
  showSignOut?: boolean;
}
const { backHref, backLabel = 'Back', admin = false, showSignOut = true } = Astro.props;
---
<header style="border-bottom:1px solid var(--color-divider)">
  <div style="max-width:820px;margin:0 auto;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap">
    <a href="/" aria-label="Apna Senior Concierge home" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit">
      <svg viewBox="0 0 44 44" width="24" height="24" aria-hidden="true" style="flex:none;overflow:visible"><g fill="none" stroke="var(--green)" stroke-width="1.25"><rect x="7" y="7" width="30" height="30"></rect><rect x="7" y="7" width="30" height="30" transform="rotate(45 22 22)"></rect><circle cx="22" cy="22" r="7.5" stroke="var(--color-accent)"></circle></g></svg>
      <span style="display:flex;align-items:baseline;gap:8px;font-size:15px">Apna<span style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--green)">Senior Concierge</span></span>
      {admin && <span style="font-size:11px;letter-spacing:0.06em;text-transform:uppercase;background:var(--color-accent);color:#fff;border-radius:4px;padding:2px 7px;margin-left:2px">Admin</span>}
    </a>
    <div style="display:flex;align-items:center;gap:16px">
      {backHref && <a href={backHref} style="font-size:14px;white-space:nowrap">{backLabel}</a>}
      {showSignOut && (
        <form method="POST" action="/api/portal/logout" style="margin:0">
          <button type="submit" class="btn btn-ghost" style="font-size:13px;padding:6px 12px">Sign out</button>
        </form>
      )}
    </div>
  </div>
</header>
